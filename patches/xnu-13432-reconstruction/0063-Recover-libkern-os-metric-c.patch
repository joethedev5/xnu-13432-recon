-/* libkern/os/metric.c:74 */
-void
-_create_os_metric_from_parts(void * buffer, uint64_t * buf_size, _os_metric_metadata_s * metadata, _os_metric_data_s * data, os_metric_label_s * label, os_metric_dimensions_s * dimensions)
+static void
+_create_os_metric_from_parts(void * buffer, uint64_t * buf_size, _os_metric_metadata_s * metadata,
+    _os_metric_data_s * data, os_metric_label_s * label, os_metric_dimensions_s * dimensions)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: _create_os_metric_from_parts");
+
+/*
+ * Build a metric record in buffer: the metadata, the fixed data
+ * payload, the histogram bins when the type is a histogram, the
+ * caller's label and the dimension labels.  Each append is checked
+ * against the metric buffer limit; buffer_size always equals the
+ * number of bytes written, which the final assert confirms.
+ */
+
+	uint64_t buffer_size = sizeof(*metadata);
+	uint64_t data_size = _os_metric_get_data_size(metadata->level);
+	size_t bin_size = sizeof(uint64_t) * metadata->bins;
+	uint8_t * p = buffer;
+
+	/* Copy the metadata record. */
+	memcpy(p, metadata, sizeof(*metadata));
+
+	p += sizeof(*metadata);
+
+	/* Copy the fixed data payload. */
+	assert3u(buffer_size + data_size, <, OS_METRIC_MAX_DATA_SIZE);
+	memcpy(p, data, data_size);
+	buffer_size += data_size;
+	p += data_size;
+
+	/* A histogram carries its bins after the fixed data payload. */
+	if (metadata->bins != 0) {
+		if (metadata->type != _OS_METRIC_TYPE_HISTOGRAM) {
+			panic("Metric had multiple bins but was %d NOT a histogram type!", metadata->type);
+		}
+		assert3u(buffer_size + bin_size, <, OS_METRIC_MAX_DATA_SIZE);
+		memcpy(p, _os_metric_get_bins(metadata->bins, data_size, data), bin_size);
+		buffer_size += bin_size;
+		p += bin_size;
+	}
+
+	/* Copy the caller's label. */
+	assert3u(buffer_size + label->blob_size, <, OS_METRIC_MAX_DATA_SIZE);
+	memcpy(p, label->blob, label->blob_size);
+	buffer_size += label->blob_size;
+	p += label->blob_size;
+
+	/* Copy the dimension labels, if any. */
+	if (dimensions != NULL) {
+		os_metric_label_s * dlist = dimensions->list[0];
+		for (size_t current = 0; current < dimensions->size; current++) {
+			size_t size = dlist[current].blob_size;
+			assert3u(buffer_size + size, <, OS_METRIC_MAX_DATA_SIZE);
+			memcpy(p, dlist[current].blob, size);
+			p += size;
+			buffer_size += size;
+		}
+	}
+
+	*buf_size = buffer_size;
+	assert3u(p - (uint8_t *)buffer, ==, buffer_size);
 }
 
-/* libkern/os/metric.c:136 */
-_Bool
-_send_os_metric_to_log_queue(void * buff, uint64_t buff_len, _os_metric_base_type_t base_type, const char * uuid, uint64_t ts, uint32_t offset, uint16_t sid, _Bool stream_log)
+static bool
+_send_os_metric_to_log_queue(void * buff, uint64_t buff_len, _os_metric_base_type_t base_type, void * uuid, uint64_t ts, uint32_t offset, uint16_t sid, _Bool stream_log)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: _send_os_metric_to_log_queue");
+	bool safe = oslog_is_safe() || startup_phase <= STARTUP_SUB_EARLY_BOOT;
+	if (_os_metric_disabled() || !safe) {
+		counter_inc(&oslog_p_metric_dropped_msgcount);
+		return false;
+	}
+
+	if (buff_len > OS_METRIC_MAX_DATA_SIZE) {
+		counter_inc(&oslog_p_metric_dropped_msgcount);
+		return false;
+	}
+
+	__attribute__((uninitialized))
+	uint8_t pubdata[OS_METRIC_BUFFER_MAX_SIZE];
+	struct os_log_context_s ctx = {};
+
+	/* Initialize the encoder context with the public buffer. */
+	os_log_context_init(&ctx, &os_log_mem, pubdata, sizeof(pubdata));
+
+	/* Encode the metric body into the context. */
+	if (!os_metric_context_encode(&ctx, uuid, offset, buff, buff_len, sid, "%s", "")) {
+		counter_inc(&oslog_p_metric_dropped_msgcount);
+		os_log_context_free(&ctx);
+		return false;
+	}
+
+	firehose_tracepoint_namespace_t ns = firehose_tracepoint_namespace_metric;
+	firehose_tracepoint_flags_t flags = _firehose_tracepoint_flags_pc_style_uuid_relative | _firehose_tracepoint_flags_metric_has_context_data;
+
+	if (os_log_subsystem_id_valid(sid)) {
+		flags |= _firehose_tracepoint_flags_metric_has_subsystem;
+	}
+	firehose_tracepoint_id_u trace_id = {
+		.ftid_value = FIREHOSE_TRACE_ID_MAKE(ns, base_type, flags, offset)
+	};
+
+	log_payload_s log = {};
+	log_payload_init(&log, firehose_stream_metric, trace_id, ts, ctx.ctx_content_sz, ctx.ctx_content_sz);
+
+	if (!log_queue_log(&log, ctx.ctx_buffer, stream_log)) {
+		counter_inc(&oslog_p_metric_dropped_msgcount);
+		os_log_context_free(&ctx);
+		return false;
+	}
+	os_log_context_free(&ctx);
+	return true;
 }
 
-/* libkern/os/metric.c:187 */
-_Bool
-os_metric_coprocessor(os_log_t oslog, _os_metric_metadata_s * metadata, _os_metric_data_s * data, os_metric_label_s * label, os_metric_dimensions_s * dimensions, const char * uuid, uint64_t timestamp, uint32_t offset, _Bool stream_log)
+/* The coprocessor entry point: build the record, then send it. */
+
+bool os_metric_coprocessor(os_log_t oslog, _os_metric_metadata_s * metadata, _os_metric_data_s * data, os_metric_label_s * label, os_metric_dimensions_s * dimensions, void * uuid, uint64_t timestamp, uint32_t offset, _Bool stream_log)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: os_metric_coprocessor");
+	uint8_t buffer[OS_METRIC_BUFFER_MAX_SIZE] = {};
+	uint64_t buff_size = 0;
+	const uint16_t sid = get_os_log_subsystem_id(oslog);
+
+	assert(metadata);
+	assert(data);
+	assert(label);
+
+	/* Serialize the record into buffer. */
+	_create_os_metric_from_parts(buffer, &buff_size, metadata, data, label, dimensions);
+
+	/* Send the record to the log queue. */
+	bool ret = _send_os_metric_to_log_queue(&buffer, buff_size, metadata->base_type, uuid, timestamp, offset, sid, stream_log);
+
+	/* The coprocessor reports whether the record was dropped. */
+
+	return !ret;
 }
+
