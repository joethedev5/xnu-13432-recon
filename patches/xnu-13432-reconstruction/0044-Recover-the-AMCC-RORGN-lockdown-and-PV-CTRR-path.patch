+static void
 lock_mmu(uint64_t begin, uint64_t end)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: lock_mmu");
+	if (!pv_ctrr_available) {
+		printf("PV CTRR unavailable, skipping lockdown\n");
+		return;
+	}
+
+	const uint64_t ctrr_block_size = 1ULL << PV_CTRR_REG(PV_CTRR_BLOCK_SIZE_OFFSET);
+
+	uint64_t ctrr_ctl = PV_CTRR_CTL_LOCK | PV_CTRR_CTL_ENABLE | PV_CTRR_CTL_WRPROTECT;
+	uint64_t ctxr_ctl = PV_CTXR_CTL_ENABLE;
+
+	assert(PV_CTRR_REG64(PV_CTRR_A_LWR_OFFSET) != 0);
+	assert(PV_CTRR_REG64(PV_CTRR_A_LWR_OFFSET) <= PV_CTRR_REG64(PV_CTRR_A_UPR_OFFSET));
+	if ((PV_CTRR_REG64(PV_CTRR_A_CTL_OFFSET) & PV_CTRR_CTL_LOCK) == 0) {
+		PV_CTRR_REG64(PV_CTRR_A_CTL_OFFSET) = ctrr_ctl;
+	}
+	assert(PV_CTRR_REG64(PV_CTRR_B_LWR_OFFSET) != 0);
+	assert(PV_CTRR_REG64(PV_CTRR_B_LWR_OFFSET) <= PV_CTRR_REG64(PV_CTRR_B_UPR_OFFSET));
+	if ((PV_CTRR_REG64(PV_CTRR_B_CTL_OFFSET) & PV_CTRR_CTL_LOCK) == 0) {
+		PV_CTRR_REG64(PV_CTRR_B_CTL_OFFSET) = ctrr_ctl;
+	}
+
+	assert(PV_CTRR_REG64(PV_CTRR_C_LWR_OFFSET) != 0);
+	assert(PV_CTRR_REG64(PV_CTRR_C_LWR_OFFSET) <= PV_CTRR_REG64(PV_CTRR_C_UPR_OFFSET));
+	assert(PV_CTRR_REG64(PV_CTRR_C_CTL_OFFSET) == 0);
+	PV_CTRR_REG64(PV_CTRR_C_CTL_OFFSET) = ctrr_ctl;
+
+	assert(PV_CTRR_REG64(PV_CTRR_D_LWR_OFFSET) == (begin & ~(ctrr_block_size - 1)));
+	assert(PV_CTRR_REG64(PV_CTRR_D_UPR_OFFSET) == (end & ~(ctrr_block_size - 1)));
+	assert(PV_CTRR_REG64(PV_CTRR_D_CTL_OFFSET) == 0);
+	PV_CTRR_REG64(PV_CTRR_D_CTL_OFFSET) = ctrr_ctl;
+
+	assert(PV_CTRR_REG64(PV_CTXR_A_LWR_OFFSET) != 0);
+	assert(PV_CTRR_REG64(PV_CTXR_A_LWR_OFFSET) <= PV_CTRR_REG64(PV_CTXR_A_UPR_OFFSET));
+	assert(PV_CTRR_REG64(PV_CTXR_A_CTL_OFFSET) == 0);
+	PV_CTRR_REG64(PV_CTXR_A_CTL_OFFSET) = ctxr_ctl;
+
+	assert(PV_CTRR_REG64(PV_CTXR_B_LWR_OFFSET) != 0);
+	assert(PV_CTRR_REG64(PV_CTXR_B_LWR_OFFSET) <= PV_CTRR_REG64(PV_CTXR_B_UPR_OFFSET));
+	assert(PV_CTRR_REG64(PV_CTXR_B_CTL_OFFSET) == 0);
+	PV_CTRR_REG64(PV_CTXR_B_CTL_OFFSET) = ctxr_ctl;
+
+	assert(PV_CTRR_REG64(PV_CTXR_C_LWR_OFFSET) != 0);
+	assert(PV_CTRR_REG64(PV_CTXR_C_LWR_OFFSET) <= PV_CTRR_REG64(PV_CTXR_C_UPR_OFFSET));
+	assert(PV_CTRR_REG64(PV_CTXR_C_CTL_OFFSET) == 0);
+	PV_CTRR_REG64(PV_CTXR_C_CTL_OFFSET) = ctxr_ctl;
+
+	assert(PV_CTRR_REG64(PV_CTXR_D_LWR_OFFSET) == (begin & ~(ctrr_block_size - 1)));
+	assert(PV_CTRR_REG64(PV_CTXR_D_UPR_OFFSET) == (end & ~(ctrr_block_size - 1)));
+	assert(PV_CTRR_REG64(PV_CTXR_D_CTL_OFFSET) == 0);
+	PV_CTRR_REG64(PV_CTXR_D_CTL_OFFSET) = ctxr_ctl;
+
+	rorgn_validate_core();
 }
 
 /* osfmk/arm64/amcc_rorgn_ppl.c:176 */
 void
 rorgn_lockdown(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: rorgn_lockdown");
+	if (!ml_unsafe_kernel_text()) {
+		printf("CTRR (MMU) Begin: %p End: %p, setting lockdown\n", (void *)ctrr_begin, (void *)ctrr_end);
+		lock_mmu(ctrr_begin, ctrr_end);
+	}
 }
 
 /* osfmk/arm64/amcc_rorgn_ppl.c:231 */
 void
 rorgn_validate_core(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: rorgn_validate_core");
+	if (ml_unsafe_kernel_text()) {
+		return;
+	}
+
+	if (!pv_ctrr_available) {
+		return;
+	}
+
+	const uint64_t ctrr_block_size = 1ULL << PV_CTRR_REG(PV_CTRR_BLOCK_SIZE_OFFSET);
+
+	assert(PV_CTRR_REG64(PV_CTRR_A_CTL_OFFSET) & PV_CTRR_CTL_LOCK);
+	assert(PV_CTRR_REG64(PV_CTRR_B_CTL_OFFSET) & PV_CTRR_CTL_LOCK);
+	assert(PV_CTRR_REG64(PV_CTRR_C_CTL_OFFSET) & PV_CTRR_CTL_LOCK);
+	assert(PV_CTRR_REG64(PV_CTRR_D_LWR_OFFSET) == (ctrr_begin & ~(ctrr_block_size - 1)));
+	assert(PV_CTRR_REG64(PV_CTRR_D_UPR_OFFSET) == (ctrr_end & ~(ctrr_block_size - 1)));
+
+	uint64_t ctrr_d_ctl = PV_CTRR_REG64(PV_CTRR_D_CTL_OFFSET);
+	assert(ctrr_d_ctl & PV_CTRR_CTL_LOCK);
+	assert(ctrr_d_ctl & PV_CTRR_CTL_ENABLE);
+	assert(ctrr_d_ctl & PV_CTRR_CTL_WRPROTECT);
+
+	assert(PV_CTRR_REG64(PV_CTXR_A_CTL_OFFSET) & PV_CTRR_CTL_LOCK);
+	assert(PV_CTRR_REG64(PV_CTXR_B_CTL_OFFSET) & PV_CTRR_CTL_LOCK);
+	assert(PV_CTRR_REG64(PV_CTXR_C_CTL_OFFSET) & PV_CTRR_CTL_LOCK);
+	assert(PV_CTRR_REG64(PV_CTXR_D_LWR_OFFSET) == (ctrr_begin & ~(ctrr_block_size - 1)));
+	assert(PV_CTRR_REG64(PV_CTXR_D_UPR_OFFSET) == (ctrr_end & ~(ctrr_block_size - 1)));
+
+	assert(PV_CTRR_REG64(PV_CTXR_D_CTL_OFFSET) & PV_CTRR_CTL_LOCK);
 }
