+#include <arm64/amcc_rorgn.h>
 
 #define RECON_OSFMK_ARM64_AMCC_RORGN_COMMON_C 1
 
+/* osfmk/arm64/amcc_rorgn_common.c:43 */
+vm_offset_t rorgn_begin;
+/* osfmk/arm64/amcc_rorgn_common.c:44 */
+vm_offset_t rorgn_end;
+
 /* osfmk/arm64/amcc_rorgn_common.c:61 */
 _Bool
 rorgn_contains(const vm_offset_t addr, vm_size_t size, _Bool defval)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: rorgn_contains");
+	if (ml_unsafe_kernel_text()) {
+		return defval;
+	}
+
+	if (startup_phase < 20) {
+		return defval;
+	}
+
+	if (rorgn_begin == 0 && rorgn_end == 0) {
+		return defval;
+	}
+
+	const vm_map_address_t pa = kvtophys(addr);
+	vm_map_address_t pa_end;
+
+	if (os_add_overflow(pa, size, &pa_end)) {
+		panic("overflow in rorgn_contains: %p + %zu", pa, size);
+	}
+
+	return (pa >= rorgn_begin) && (pa_end <= rorgn_end + 1);
 }
