-void
+static void
 pv_ctrr_map_reg_base(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: pv_ctrr_map_reg_base");
+	struct {
+		uint64_t block_offset;
+		uint64_t block_size;
+	} const *reg = NULL;
+	unsigned int reg_size;
+
+	DTEntry avp_ctrr_node = NULL;
+	if (SecureDTLookupEntry(NULL, "/arm-io/avp-ctrr", &avp_ctrr_node) != kSuccess) {
+		/*
+		 * The AVP CTRR node is absent on platforms without the
+		 * protected virtualisation CTRR.
+		 */
+		printf("No devicetree entry found for AVP CTRR\n");
+		return;
+	}
+
+	const char *compatible = NULL;
+	unsigned int compatible_size;
+	if (SecureDTGetProperty(avp_ctrr_node, "compatible", (const void **)&compatible, &compatible_size) != kSuccess || strcmp(compatible, "avp,ctrr") != 0) {
+		printf("No devicetree entry found for AVP CTRR\n");
+		return;
+	}
+
+	if (SecureDTGetProperty(avp_ctrr_node, "reg", (const void **)&reg, &reg_size) != kSuccess) {
+		panic("Unable to find the '%s' property on the AVP CTRR devicetree node", "reg");
+	}
+	assert(reg_size == sizeof(*reg));
+
+	const vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+	pv_ctrr_reg_base = ml_io_map(soc_base_phys + reg->block_offset, reg->block_size);
+	pv_ctrr_reg_size = reg->block_size;
 }
 
 /* osfmk/arm64/amcc_rorgn_pv_ctrr.c:82 */
 void
 pv_ctrr_init(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: pv_ctrr_init");
+	pv_ctrr_map_reg_base();
+
+	if (pv_ctrr_reg_base == 0) {
+		return;
+	}
+
+	if (*(volatile uint32_t *)(pv_ctrr_reg_base) != 'ctrr' || *(volatile uint32_t *)(pv_ctrr_reg_base + 4) != 1) {
+		/*
+		 * The register block does not carry the CTRR signature or
+		 * the expected version, so it is not the device we expect.
+		 */
+		printf("No AVP CTRR device found\n");
+		return;
+	}
+	assert(PV_CTRR_REG(PV_CTRR_NUM_REGIONS_OFFSET) >= 8);
+
+	if (PV_CTRR_REG64(PV_CTRR_D_LWR_OFFSET) == 0) {
+		/*
+		 * The firmware did not program the first protected region,
+		 * so the CTRR is not usable for lockdown.
+		 */
+		printf("No firmware support for AVP CTRR\n");
+		return;
+	}
+
+	pv_ctrr_available = true;
 }
diff --git a/osfmk/arm64/amcc_rorgn_pv_ctrr.h b/osfmk/arm64/amcc_rorgn_pv_ctrr.h
new file mode 100644
index 000000000..7d0a873bb
--- /dev/null
+++ b/osfmk/arm64/amcc_rorgn_pv_ctrr.h
@@ -0,0 +1,72 @@
+/*
+ * Reconstruction of osfmk/arm64/amcc_rorgn_pv_ctrr.h from the xnu-13432
+ * reference kernel.
+ *
+ * The register offsets, control bits and accessor macros are recovered
+ * from the assert expression strings embedded in the kasan kernel and
+ * from the instruction streams of amcc_rorgn_ppl.c and
+ * amcc_rorgn_pv_ctrr.c.  The original include order and comments are not
+ * recovered.
+ */
+#ifndef _ARM64_AMCC_RORGN_PV_CTRR_H_
+#define _ARM64_AMCC_RORGN_PV_CTRR_H_
+
+#include <sys/cdefs.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+#include <libkern/section_keywords.h>
+
+__BEGIN_DECLS
+
+/* CTRR register block offsets. */
+#define PV_CTRR_SIGNATURE_OFFSET        0x00
+#define PV_CTRR_VERSION_OFFSET          0x04
+#define PV_CTRR_NUM_REGIONS_OFFSET      0x0c
+#define PV_CTRR_BLOCK_SIZE_OFFSET       0x10
+
+#define PV_CTRR_A_LWR_OFFSET            0x40
+#define PV_CTRR_A_UPR_OFFSET            0x48
+#define PV_CTRR_A_CTL_OFFSET            0x50
+#define PV_CTRR_B_LWR_OFFSET            0x60
+#define PV_CTRR_B_UPR_OFFSET            0x68
+#define PV_CTRR_B_CTL_OFFSET            0x70
+#define PV_CTRR_C_LWR_OFFSET            0x80
+#define PV_CTRR_C_UPR_OFFSET            0x88
+#define PV_CTRR_C_CTL_OFFSET            0x90
+#define PV_CTRR_D_LWR_OFFSET            0xa0
+#define PV_CTRR_D_UPR_OFFSET            0xa8
+#define PV_CTRR_D_CTL_OFFSET            0xb0
+
+#define PV_CTXR_A_LWR_OFFSET            0xc0
+#define PV_CTXR_A_UPR_OFFSET            0xc8
+#define PV_CTXR_A_CTL_OFFSET            0xd0
+#define PV_CTXR_B_LWR_OFFSET            0xe0
+#define PV_CTXR_B_UPR_OFFSET            0xe8
+#define PV_CTXR_B_CTL_OFFSET            0xf0
+#define PV_CTXR_C_LWR_OFFSET            0x100
+#define PV_CTXR_C_UPR_OFFSET            0x108
+#define PV_CTXR_C_CTL_OFFSET            0x110
+#define PV_CTXR_D_LWR_OFFSET            0x120
+#define PV_CTXR_D_UPR_OFFSET            0x128
+#define PV_CTXR_D_CTL_OFFSET            0x130
+
+/* Control register bits. */
+#define PV_CTRR_CTL_LOCK                0x1
+#define PV_CTRR_CTL_ENABLE              0x2
+#define PV_CTRR_CTL_WRPROTECT           0x4
+#define PV_CTXR_CTL_ENABLE              0x1
+
+extern _Bool pv_ctrr_available;
+extern vm_offset_t pv_ctrr_reg_base;
+extern vm_size_t pv_ctrr_reg_size;
+
+#define PV_CTRR_REG(offset) \
+	(*(volatile uint32_t *)((uintptr_t)pv_ctrr_reg_base + (offset)))
+#define PV_CTRR_REG64(offset) \
+	(*(volatile uint64_t *)((uintptr_t)pv_ctrr_reg_base + (offset)))
+
+void pv_ctrr_init(void);
+
+__END_DECLS
+
+#endif /* _ARM64_AMCC_RORGN_PV_CTRR_H_ */
