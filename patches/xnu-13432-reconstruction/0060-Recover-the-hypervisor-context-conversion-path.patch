 }
 
+/*
+ * Convert the guest's saved context between the native and the shared
+ * layout, in the direction the caller asks for.
+ *
+ * The two layouts are compared before the conversion: a major-version
+ * mismatch means the guest speaks a different context version, and a
+ * measurement mismatch means the individual context ranges moved.  The
+ * cases are:
+ *
+ *  - both mismatches: the context is converted through kif_intermediate.
+ *    The intermediate holds the layout of the shared major version, so
+ *    the context is first converted between the native and intermediate
+ *    layouts and then between the intermediate and shared layouts (in
+ *    the order required by the direction).  The major-version conversion
+ *    itself is not implemented and only asserts.
+ *  - major mismatch only: the layouts are directly compatible, but the
+ *    version conversion is not implemented; the call only asserts.
+ *  - measurement mismatch only: the layouts differ and are converted
+ *    directly.
+ *
+ * After a shared-to-native conversion caused by a major mismatch, the
+ * kernel interface frame's read-only root is stamped with the version
+ * of the ARM hypervisor state the kernel now speaks.
+ *
+ * Reference layout: 264-265 assertions, 267-274 source/destination
+ * selection, 278 copy_ro, 280-283 mismatch and version facts, 285-306
+ * the conversion cases, 307-310 the version stamp.
+ */
 /* osfmk/arm64/hv/hv_compat_paranested.c:261 */
 void
 convert_context_by_guest(hv_vcpu_t * vcpu, hv_context_conversion_dir_e direction)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: convert_context_by_guest");
+	assert(vcpu->kif_shared != NULL && vcpu->kif != NULL && vcpu->kif != vcpu->kif_shared);
+	assert(direction == NATIVE_TO_SHARED || direction == SHARED_TO_NATIVE);
+
+	arm_guest_context_t * src = direction == NATIVE_TO_SHARED ? vcpu->kif : vcpu->kif_shared;
+	arm_guest_context_t * dst = direction == NATIVE_TO_SHARED ? vcpu->kif_shared : vcpu->kif;
+
+	const size_t src_size = direction == NATIVE_TO_SHARED ?
+	    sizeof(arm_guest_context_t) : vcpu->kif_shared_size;
+	const size_t dst_size = direction == NATIVE_TO_SHARED ?
+	    vcpu->kif_shared_size : sizeof(arm_guest_context_t);
+
+	const hv_paranested_measurement_t * src_measurement = direction == NATIVE_TO_SHARED ?
+	    &native_measurement : &shared_measurement;
+	const hv_paranested_measurement_t * dst_measurement = direction == NATIVE_TO_SHARED ?
+	    &shared_measurement : &native_measurement;
+
+	const bool copy_ro = direction == SHARED_TO_NATIVE;
+
+	const bool major_version_mismatch = hv_guest_has_major_version_mismatch();
+	const bool context_measurement_mismatch = hv_guest_has_context_measurement_mismatch();
+	const hv_context_version_major_t src_version_major = hv_get_state_version_major(src_measurement);
+	const hv_context_version_major_t dst_version_major = hv_get_state_version_major(dst_measurement);
+
+	if (major_version_mismatch && context_measurement_mismatch) {
+		const hv_paranested_measurement_t * intermediate_measurement =
+		    hv_get_supported_measurement_nofail(hv_get_shared_version_major());
+
+		if (direction == NATIVE_TO_SHARED) {
+			hv_convert_context_major_version(src, src_version_major, vcpu->kif_intermediate,
+			    dst_version_major, copy_ro);
+
+			hv_convert_context_from_measurements(vcpu->kif_intermediate,
+			    vcpu->kif_intermediate_size, intermediate_measurement, dst,
+			    dst_size, dst_measurement, copy_ro);
+		} else {
+			hv_convert_context_from_measurements(src, src_size, src_measurement, vcpu->kif_intermediate,
+			    vcpu->kif_intermediate_size, intermediate_measurement, copy_ro);
+
+			hv_convert_context_major_version(vcpu->kif_intermediate, src_version_major, dst,
+			    dst_version_major, copy_ro);
+		}
+	} else if (major_version_mismatch) {
+		hv_convert_context_major_version(src, src_version_major, dst,
+		    dst_version_major, copy_ro);
+	} else {
+		assert(!major_version_mismatch && context_measurement_mismatch);
+
+		hv_convert_context_from_measurements(src, src_size, src_measurement,
+		    dst, dst_size, dst_measurement, copy_ro);
+	}
+	if (major_version_mismatch && direction == SHARED_TO_NATIVE) {
+		/*
+		 * The kernel interface frame now carries a context in the
+		 * guest's shared version.
+		 */
+		vcpu->kif->ro.ver = ARM_HV_STATE_VER;
+	}
 }
