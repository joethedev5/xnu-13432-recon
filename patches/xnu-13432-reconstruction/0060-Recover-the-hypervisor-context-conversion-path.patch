+/*
+ * Convert a context between two major versions.
+ *
+ * The reference does not implement the conversion: the body is the
+ * assertion below, so development and kasan kernels panic here.  In
+ * release kernels assert() is empty and the function falls away, which
+ * leaves the callers' explicit kif_intermediate conversions in charge.
+ */
+/* osfmk/arm64/hv/hv_compat_paranested.c:157 */
+static inline void
+hv_convert_context_major_version(const void * src, hv_context_version_major_t src_version_major,
+    void * dst, hv_context_version_major_t dst_version_major, bool copy_ro)
+{
+	(void)src;
+	(void)src_version_major;
+	(void)dst;
+	(void)dst_version_major;
+	(void)copy_ro;
+
+	assert(false);
+}
