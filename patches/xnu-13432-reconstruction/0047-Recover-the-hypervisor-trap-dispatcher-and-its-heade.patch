 /* osfmk/arm64/hv/hv.c:338 */
-hv_return_t
+static hv_return_t
 _hv_trap_capabilities(uint64_t arg)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: _hv_trap_capabilities");
+	/* hv.c:343 */
+	assert(hv_get_support() != 0);
+
+	/* hv.c:345 */
+	const uint32_t caps_buffer_size =
+	    hv_get_shared_measurement()->measurement_array[23].size;
+
+	/* hv.c:347 */
+	vm_offset_t caps_buffer;
+
+	/* hv.c:349 */
+	kern_return_t allocate_retval = kernel_memory_allocate(kernel_map,
+	    &caps_buffer, caps_buffer_size, PAGE_MASK, KMA_ZERO,
+	    VM_KERN_MEMORY_HV);
+
+	/* hv.c:351 */
+	if (allocate_retval != KERN_SUCCESS) {
+		return HV_NO_RESOURCES;
+	}
+
+	/* hv.c:355 */
+	hv_return_t get_caps_retval = hv_get_host_capabilities(caps_buffer);
+	/* hv.c:356 */
+	if (get_caps_retval != HV_SUCCESS) {
+		/* hv.c:357 */
+		kmem_free(kernel_map, caps_buffer, caps_buffer_size);
+		/* hv.c:358 */
+		return get_caps_retval;
+	}
+
+	/* hv.c:365 */
+	const uint32_t capabilities_size = MIN(caps_buffer_size,
+	    (uint32_t)sizeof(hv_capabilities_t));
+
+	/* hv.c:370 */
+	vm_offset_t bounded_caps_buffer = caps_buffer;
+	/* hv.c:371 */
+	int copy_retval = copyout((const void *)bounded_caps_buffer,
+	    (user_addr_t)arg, capabilities_size);
+
+	/* hv.c:373 */
+	kmem_free(kernel_map, caps_buffer, caps_buffer_size);
+
+	/* hv.c:374 */
+	return copy_retval == 0 ? HV_SUCCESS : HV_ERROR;
 }
 
+/*
+ * osfmk/arm64/hv/hv.c:380
+ *
+ * Trap dispatch table.  The reference names the indices through the
+ * TRAP_HV_* definitions in hv_interface.h; only TRAP_HV_CAPABILITIES is
+ * confirmed by the public test sources, so the recovered indices are
+ * used directly here.
+ */
+static hv_return_t (* const _vm_trap[])(uint64_t arg) = {
+	[0]  = _hv_trap_capabilities,                    /* TRAP_HV_CAPABILITIES */
+	[1]  = hv_trap_vm_create,                        /* TRAP_HV_VM_CREATE */
+	[2]  = hv_trap_vm_destroy,                       /* TRAP_HV_VM_DESTROY */
+	[3]  = hv_trap_vm_map,                           /* TRAP_HV_VM_MAP */
+	[4]  = hv_trap_vm_unmap,                         /* TRAP_HV_VM_UNMAP */
+	[5]  = hv_trap_vm_protect,                       /* TRAP_HV_VM_PROTECT */
+	[6]  = hv_trap_vcpu_create,                      /* TRAP_HV_VCPU_CREATE */
+	[7]  = hv_trap_vcpu_destroy,                     /* TRAP_HV_VCPU_DESTROY */
+	[8]  = hv_trap_vcpu_sysregs_sync,                /* TRAP_HV_VCPU_SYSREGS_SYNC */
+	[9]  = hv_trap_vcpu_run,                         /* TRAP_HV_VCPU_RUN */
+	[10] = hv_trap_vcpu_run_cancel,                  /* TRAP_HV_VCPU_RUN_CANCEL */
+	[18] = hv_trap_paravirtualized_nested_service,   /* TRAP_HV_PARAVIRTUALIZED_NESTED_SERVICE */
+};
+
+/* osfmk/arm64/hv/hv.c:405 */
+LCK_GRP_DECLARE(hv_lck_grp, "hv");
+
+/* osfmk/arm64/hv/hv.c:407 */
+LCK_MTX_DECLARE(hv_mtx, &hv_lck_grp);
+
 /* osfmk/arm64/hv/hv.c:410 */
 void
 hv_trap(arm_saved_state_t * state)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: hv_trap");
+	/* hv.c:412 */
+	uint64_t trap = saved_state64(state)->x[0];
+	/* hv.c:413 */
+	uint64_t arg = saved_state64(state)->x[1];
+
+	/* hv.c:415 */
+	KDBG_RELEASE(MACHDBG_CODE(DBG_MACH_EXCP_SC, 5) | DBG_FUNC_START,
+	    trap, arg);
+
+	hv_return_t result = HV_ERROR;
+	/* hv.c:419 */
+	if (hv_get_support() != 0) {
+		/* hv.c:421 */
+		if (trap < sizeof(_vm_trap) / sizeof(_vm_trap[0]) &&
+		    _vm_trap[trap] != NULL) {
+			/* hv.c:424 */
+			result = _vm_trap[trap](arg);
+		}
+	} else {
+		result = HV_UNSUPPORTED;
+	}
+
+	saved_state64(state)->x[0] = result;
+
+	/* hv.c:427 */
+	KDBG_RELEASE(MACHDBG_CODE(DBG_MACH_EXCP_SC, 5) | DBG_FUNC_END,
+	    result);
 }
 
 /* osfmk/arm64/hv/hv.c:433 */
 void
 hv_callback_thread_destroy(void * thread_target)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: hv_callback_thread_destroy");
+	/* hv.c:435 */
+	hv_vcpu_destroy(thread_target);
 }
 
 /* osfmk/arm64/hv/hv.c:439 */
 void
 hv_callback_task_destroy(void * task_target)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: hv_callback_task_destroy");
+	/* hv.c:441 */
+	hv_vm_destroy(task_target);
 }
