From 8999319c52144cacd5da0a2d0694c41b67e95493 Mon Sep 17 00:00:00 2001
From: joethedev5 <deepsbx1@proton.me>
Date: Wed, 25 Nov 2026 03:43:03 +0000
Subject: [PATCH 31/32] Match the reference TCP receive accounting and ECN
 feedback flow

The 13432 tcpcb replaces total_ect_packets_marked/acked with a single
total_packets_received at offset 408 and adds t_recv_bg_algo at 495;
tcp_input now counts received packets in that field.

tcp_input delegates AccECN feedback to tcp_accecn_feedback and the
combined ECN feedback path to tcp_ecn_feedback, as the reference's
calls at its input lines 1619, 2951, 3008 and 3416 show.  The last-ACK
decoder and the aggressive ECE heuristic had already moved to
tcp_ecn.c; their tcp_input copies are removed.  tcp_classic_ecn_feedback
uses tcp_ecn_check_ece_heur, whose reference mask also clears
TE_SETUPSENT.

Authored-By: joethedev5 <joeshmo@nunya.com>
---
 bsd/netinet/tcp_ecn.c   |   5 +-
 bsd/netinet/tcp_input.c | 229 ++--------------------------------------
 bsd/netinet/tcp_var.h   |  10 +-
 3 files changed, 18 insertions(+), 226 deletions(-)

diff --git a/bsd/netinet/tcp_ecn.c b/bsd/netinet/tcp_ecn.c
index f8522d9cb..ad8215c4c 100644
--- a/bsd/netinet/tcp_ecn.c
+++ b/bsd/netinet/tcp_ecn.c
@@ -864,7 +864,7 @@ tcp_classic_ecn_feedback(struct tcpcb * tp, struct tcphdr * th, uint32_t bytes_a
 	 * For classic ECN, congestion event is receiving TH_ECE.
 	 * Disable ECN if > 90% marking is observed in ACK packets.
 	 */
-	tcp_ece_aggressive_heur(tp, pkts_acked);
+	tcp_ecn_check_ece_heur(tp, pkts_acked);
 	/*
 	 * Reduce the congestion window if we haven't done so.
 	 */
@@ -1124,7 +1124,8 @@ tcp_ecn_check_ece_heur(struct tcpcb * tp, uint32_t pkts_acked)
 	}
 
 	tcp_heuristic_ecn_aggressive(tp);
-	tp->ecn_flags &= ~(TE_SENDIPECT | TE_ECEHEURI_SET);
+	/* The reference also clears classic ECN setup, disabling ECN outright. */
+	tp->ecn_flags &= ~(TE_SETUPSENT | TE_SENDIPECT | TE_ECEHEURI_SET);
 	tp->ecn_flags |= TE_ECEHEURI_SET;
 }
 
diff --git a/bsd/netinet/tcp_input.c b/bsd/netinet/tcp_input.c
index 6f9f353a8..81a68784c 100644
--- a/bsd/netinet/tcp_input.c
+++ b/bsd/netinet/tcp_input.c
@@ -1329,133 +1329,6 @@ tcp_input_process_accecn_synack(struct tcpcb *tp, struct inpcb *inp, struct tcpo
 	}
