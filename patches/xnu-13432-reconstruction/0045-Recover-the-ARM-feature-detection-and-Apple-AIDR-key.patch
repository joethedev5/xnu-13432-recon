From 8d1b107af44d4921ca6863b026862a65e0c91e6c Mon Sep 17 00:00:00 2001
From: joethedev5 <deepsbx1@proton.me>
Date: Wed, 25 Nov 2026 05:41:14 +0000
Subject: [PATCH] Recover the ARM feature detection and Apple AIDR keys

xnu-13432 replaced the commpage's direct feature flags with early
static_if keys.  Reconstruct the new files from the KDK 27.0.1 DWARF
and both reference kernel images:

 - osfmk/arm/arm_features.inc defines the ARM_FEAT_* / ARM_SME_* jump
   keys at lines 37-197, as attributed by the reference DWARF.
 - osfmk/arm/apple_features.inc (new) defines the 14 Apple_* keys for
   the AIDR-driven features at lines 30-47.
 - osfmk/arm64/cpu_features.c holds the per-register init routines
   (zfr0, isar0-3, mmfr0-2, pfr0-2, smfr0, fpcr, misc) and the two
   static_if initializers at lines 73-739.
 - The ID-register tests mirror the public commpage code, extended with
   the new 13432 fields (ISAR1 PAuth_LR, ISAR2 LUT, ISAR3, MMFR0
   ASIDBits, MMFR2 VARANGE_EN, PFR1 CSV2_1p2, PFR2 FPMR, SMFR0
   LUTv2/F8F16/F8F32) and the Apple AIDR bits.
 - The old ARM_FEATURE_FLAG list moves to osfmk/arm/arm_features.h so
   commpage and kern_mib keep building.

Verified against the reference disassembly: the recovered code enables
the same 82 ARM feature keys and 12 Apple keys, with matching masks,
thresholds and control flow.  Recompiling the translation unit before
and after the file split produces identical instructions apart from
the placement of the key definitions.

Authored-By: joethedev5 <joeshmo@nunya.com>
---
 bsd/kern/kern_mib.c           |   4 +-
 osfmk/arm/Makefile            |   2 +
 osfmk/arm/apple_features.inc  |  46 +++
 osfmk/arm/arm_features.h      | 131 ++++++++
 osfmk/arm/arm_features.inc    | 320 +++++++++++--------
 osfmk/arm/commpage/commpage.c |   2 +-
 osfmk/arm64/cpu_features.c    | 573 +++++++++++++++++++++++++++++-----
 osfmk/arm64/proc_reg.h        |  63 +++-
 8 files changed, 935 insertions(+), 206 deletions(-)
 create mode 100644 osfmk/arm/apple_features.inc
 create mode 100644 osfmk/arm/arm_features.h

diff --git a/bsd/kern/kern_mib.c b/bsd/kern/kern_mib.c
index e67ea79ad..421476ed1 100644
--- a/bsd/kern/kern_mib.c
+++ b/bsd/kern/kern_mib.c
@@ -1175,7 +1175,7 @@ SECURITY_READ_ONLY_LATE(int) arm64_flag = 0;
 	SYSCTL_INT(_hw_optional_arm, OID_AUTO, flag_name, CTLFLAG_RD | CTLFLAG_KERN | CTLFLAG_LOCKED, &gARM_ ## flag_name, 0, "")
 
 
-#include <arm/arm_features.inc>
+#include <arm/arm_features.h>
 #undef ARM_FEATURE_FLAG
 
 /* Legacy Names ARM Optional Feature Sysctls */
@@ -1287,7 +1287,7 @@ sysctl_hw_caps(__unused struct sysctl_oid *oidp, __unused void *arg1,
 
 	/* Report presence of all FEATs. */
 	#define ARM_FEATURE_FLAG(x) CAP_SET_BIT(x)
-	#include <arm/arm_features.inc>
+	#include <arm/arm_features.h>
 	#undef ARM_FEATURE_FLAG
 
 
