+/*
+ * arm_features.inc:667
+ */
+static void
+apple_cpu_features_init(const char *boot_args)
+{
+	uint64_t aidr = __builtin_arm_rsr64("AIDR_EL1");
+
+	uint64_t pnum = machine_read_midr();
+	if ((pnum & (MIDR_EL1_PNUM_MASK & ~0x10)) == 0x300) {
+		aidr &= ~AIDR_MILDDSB;
+	}
+
+	uint64_t mtever = aidr & AIDR_MTEVER_MASK;
+	if (mtever != 0) {
+		static_if_key_enable(Apple_MTE);
+		if (mtever == AIDR_MTEVER_V1) {
+			static_if_key_enable(Apple_MTEver_1);
+		}
+	}
+	if (aidr & AIDR_TSO) {
+		static_if_key_enable(Apple_TSO);
+	}
+	if (aidr & AIDR_APFLG) {
+		static_if_key_enable(Apple_APFLG);
+	}
+	if (aidr & AIDR_PRSVScalarFP) {
+		static_if_key_enable(Apple_PRSVScalarFP);
+	}
+	if (aidr & AIDR_AFP) {
+		static_if_key_enable(Apple_AFP);
+	}
+	if (static_if_boot_arg_uint64(boot_args, "mdsb", 1)) {
+		if (aidr & AIDR_MILDDSB) {
+			static_if_key_enable(Apple_MILDDSB);
+		}
+	}
+	if (aidr & AIDR_TBCF) {
+		static_if_key_enable(Apple_TBCF);
+	}
+	if ((aidr & AIDR_AMAIRCFG) == 0) {
+		static_if_key_enable(Apple_AMAIRCfg);
+	}
+	if (aidr & AIDR_GEXSCM) {
+		static_if_key_enable(Apple_GEXSCM);
+	}
+	switch (aidr & AIDR_CTRR_MASK) {
+	case AIDR_CTRRv2:
+		static_if_key_enable(Apple_CTRRv2);
+		break;
+	case AIDR_CTRRv3:
+		static_if_key_enable(Apple_CTRRv3);
+		break;
+	}
+}
+/* arm_features.inc:739 */
+STATIC_IF_INIT(apple_cpu_features_init);
