+/*
+ * Reconstruction of osfmk/arm/apple_features.inc from the xnu-13432
+ * reference kernel.
+ *
+ * The Apple-specific static_if keys defined by the reference for the
+ * AIDR-driven features.  They are enabled by apple_cpu_features_init()
+ * in osfmk/arm64/cpu_features.c.
+ */
+
+#ifndef _ARM_APPLE_FEATURES_INC_
+#define _ARM_APPLE_FEATURES_INC_
+
+#include <machine/static_if.h>
+
+/* apple_features.inc:30 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_AFP);
