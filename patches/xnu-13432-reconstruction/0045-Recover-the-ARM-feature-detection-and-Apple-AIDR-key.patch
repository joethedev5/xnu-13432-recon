+/* apple_features.inc:37 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_GEXSCM);
+/* apple_features.inc:38 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_MILDDSB);
+
+/* apple_features.inc:41 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_MTE);
+/* apple_features.inc:42 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_MTEver_1);
+
+/* apple_features.inc:45 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_PRSVScalarFP);
+/* apple_features.inc:46 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_TBCF);
+/* apple_features.inc:47 */
+STATIC_IF_KEY_DEFINE_FALSE(Apple_TSO);
+
+#endif /* _ARM_APPLE_FEATURES_INC_ */
