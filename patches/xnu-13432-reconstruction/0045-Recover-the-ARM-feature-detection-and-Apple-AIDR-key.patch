-#include <arm/arm_features.inc>
+#include <arm/arm_features.h>
 #undef ARM_FEATURE_FLAG
 
 /* Legacy Names ARM Optional Feature Sysctls */
@@ -1287,7 +1287,7 @@ sysctl_hw_caps(__unused struct sysctl_oid *oidp, __unused void *arg1,
 
