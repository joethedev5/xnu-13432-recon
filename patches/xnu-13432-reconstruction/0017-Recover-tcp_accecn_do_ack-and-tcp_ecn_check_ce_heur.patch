From c0132451ec710c36c1f9c8fb14646444f9e36010 Mon Sep 17 00:00:00 2001
From: joethedev5 <deepsbx1@proton.me>
Date: Wed, 25 Nov 2026 02:33:19 +0000
Subject: [PATCH 17/19] Recover tcp_accecn_do_ack and tcp_ecn_check_ce_heur

- tcp_accecn_do_ack: accumulate CE-marked unacked segments, force an
  ACK when the previous packet carried CE or when the counter crosses
  the two-segment/sequence boundary, then record the current IP ECN
  value.
- tcp_ecn_check_ce_heur: skip when ECN is not negotiated, latch
  TE_ECEHEURI_SET, count CE packets after 20 received packets, and run
  the aggressive ECN heuristic when the counter crosses 19; clear/set
  the reference's 0x04000000 AccECN flag accordingly.

Remaining explicit stubs: 290.

Authored-By: joethedev5 <joeshmo@nunya.com>
---
 bsd/netinet/tcp_ecn.c | 47 +++++++++++++++++++++++++++++++++++++++----
 1 file changed, 43 insertions(+), 4 deletions(-)

diff --git a/bsd/netinet/tcp_ecn.c b/bsd/netinet/tcp_ecn.c
index b31bcaa27..3885743b6 100644
--- a/bsd/netinet/tcp_ecn.c
+++ b/bsd/netinet/tcp_ecn.c
@@ -10,9 +10,14 @@
 #include <sys/systm.h>
 #include <sys/kernel.h>
 #include <netinet/tcp_ecn.h>
+#include <netinet/tcp_var.h>
+#include <netinet/ip.h>
 
 #define RECON_BSD_NETINET_TCP_ECN_C 1
 
+/* Counter at 0xfffffe0007d340350 in the reference image. */
+uint32_t tcp_ecn_ce_heur_skipped;
+
 /* bsd/netinet/tcp_ecn.c:65 */
 void
 tcp_accecn_process_ip_ecn(struct tcpcb * tp, uint8_t ip_ecn)
@@ -276,16 +281,50 @@ tcp_ecn_set_ip(struct tcpcb * tp, struct inpcb * inp, struct ip * ip)
 void
 tcp_accecn_do_ack(struct tcpcb * tp, u_char ip_ecn, uint32_t segment_count)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_accecn_do_ack");
+	uint16_t unacksegs = tp->t_unacksegs_ce;
+
+	if (ip_ecn == IPTOS_ECN_CE) {
+		unacksegs = (uint16_t)(unacksegs + segment_count);
+		tp->t_unacksegs_ce = unacksegs;
+		if (tp->t_prev_ip_ecn != IPTOS_ECN_CE) {
+			tp->t_flags |= TF_ACKNOW;
+			tp->t_prev_ip_ecn = ip_ecn;
+			return;
+		}
+	}
+	if (unacksegs >= 2 &&
+	    !(unacksegs == 2 && tp->last_ack_sent == tp->rcv_nxt)) {
+		tp->t_flags |= TF_ACKNOW;
+	}
+	tp->t_prev_ip_ecn = ip_ecn;
 }
 
 /* bsd/netinet/tcp_ecn.c:1163 */
 void
 tcp_ecn_check_ce_heur(struct tcpcb * tp, uint32_t pkts_rcvd)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_ecn_check_ce_heur");
+	if ((tp->ecn_flags & TE_ECN_ON) != TE_ECN_ON) {
+		tcp_ecn_ce_heur_skipped++;
+		return;
+	}
+	if ((tp->ecn_flags & TE_ECEHEURI_SET) != 0) {
+		return;
+	}
+
+	tp->t_ecn_recv_ce_pkt =
+	    (uint8_t)(tp->t_ecn_recv_ce_pkt + pkts_rcvd);
+	if (tp->total_packets_received < 20) {
+		return;
+	}
+	if ((uint8_t)tp->t_ecn_recv_ce_pkt < 19) {
+		tp->ecn_flags |= TE_ECEHEURI_SET;
+		return;
+	}
+
+	tcp_heuristic_ecn_aggressive(tp);
+	tp->ecn_flags &= ~(TE_SENDIPECT | TE_SENDECE | TE_ECEHEURI_SET |
+	    0x04000000 /* 13432-only AccECN flag */);
+	tp->ecn_flags |= (TE_ECEHEURI_SET | 0x04000000);
 }
 
 /* bsd/netinet/tcp_ecn.c:1194 */
