diff --git a/bsd/netinet/tcp_rbbr.c b/bsd/netinet/tcp_rbbr.c
index a89e70792..a5be40a00 100644
--- a/bsd/netinet/tcp_rbbr.c
+++ b/bsd/netinet/tcp_rbbr.c
@@ -9,6 +9,7 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/kernel.h>
+#include <netinet/tcp_rbbr.h>
 
 #define RECON_BSD_NETINET_TCP_RBBR_C 1
 
@@ -288,8 +289,27 @@ tcp_rbbr_cleanup(struct tcpcb * tp)
 void
 tcp_rbbr_rwnd_init(struct tcpcb * tp)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_rbbr_rwnd_init");
+	struct tcp_rbbr_state *rbbr = tp->t_rbbr_state;
+	uint32_t rwnd;
+	uint32_t max_win;
+
+	if (rbbr == NULL) {
+		return;
+	}
+
+	/*
+	 * Initial RBBR window: 10 * MSS, rounded down to an MSS multiple
+	 * and clamped to the largest window the receive scale allows.
+	 * The reference image stores the multiplier (10) at
+	 * 0xfffffe0007cbf450.
+	 */
+	rwnd = tp->t_maxseg * 10;
+	rbbr->rwnd_est = rwnd;
+
+	rwnd = (rwnd + (tp->t_maxseg >> 1)) / tp->t_maxseg * tp->t_maxseg;
+	max_win = 0xffffu << tp->rcv_scale;
+	rbbr->win = rwnd < max_win ? rwnd : max_win;
+	rbbr->win_change_pending = 1;
 }
 
