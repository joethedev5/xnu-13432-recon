 /* bsd/netinet/tcp_rbbr.c:912 */
 void
 rbbr_update_sawtooth_detection(struct tcpcb * tp, uint32_t current_median)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: rbbr_update_sawtooth_detection");
+	struct tcp_rbbr_state *rbbr = tp->t_rbbr_state;
+	uint32_t prev_median = rbbr->prev_cruise_median;
+	uint32_t noise_margin;
+	uint32_t drop_threshold;
+
+	rbbr->total_cruise_cycles++;
+	noise_margin = prev_median + rbbr_queue_detect_noise_base_ms;
+	drop_threshold = noise_margin +
+	    rbbr->rtt_mad * rbbr_queue_detect_noise_mad_mult;
+
+	if (prev_median != 0) {
+		if (current_median > drop_threshold) {
+			rbbr->current_chain_length++;
+		} else if (prev_median > current_median &&
+		    (prev_median - current_median) >
+		    prev_median * rbbr_queue_detect_drop_pct / 100) {
+			if (rbbr->current_chain_length >=
+			    (uint16_t)rbbr_queue_detect_increases) {
+				rbbr->sawtooth_cycles +=
+				    rbbr->current_chain_length;
+			}
+			rbbr->current_chain_length = 0;
+		}
+	}
+
+	rbbr->prev_cruise_median = current_median;
 }
 
 /* bsd/netinet/tcp_rbbr.c:975 */
 void
 rbbr_finalize_sawtooth_detection(struct tcpcb * tp)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: rbbr_finalize_sawtooth_detection");
+	struct tcp_rbbr_state *rbbr = tp->t_rbbr_state;
+	uint32_t fraction_pct;
+
+	if (rbbr->total_cruise_cycles == 0) {
+		rbbr->queue_competition_detected = false;
+		return;
+	}
+
+	fraction_pct = rbbr->sawtooth_cycles * 100 /
+	    rbbr->total_cruise_cycles;
+	if (fraction_pct >= (uint32_t)rbbr_queue_detect_fraction_pct) {
+		rbbr->queue_competition_detected = true;
+		rbbr->skip_rwnd_restrict = 2;
+		if (tcp_is_log_enabled(tp, TLEF_LOG)) {
+			tcp_log_bbr("rbbr_finalize_sawtooth_detection", 1004, tp,
+			    "rbbr: queue competition detected, skipping RWND "
+			    "restrict sawtooth_cycles=%u total_cycles=%u "
+			    "fraction=%u%% threshold=%u%%",
+			    rbbr->sawtooth_cycles, rbbr->total_cruise_cycles,
+			    fraction_pct, rbbr_queue_detect_fraction_pct);
+		}
+	} else {
+		rbbr->queue_competition_detected = false;
+	}
 }
 
