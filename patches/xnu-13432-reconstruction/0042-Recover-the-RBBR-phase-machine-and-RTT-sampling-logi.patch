+	/*
+	 * The byte target applies only when timestamps let us measure RTTs;
+	 * otherwise fall through to the time-based target.
+	 */
+	if ((tp->t_flags & (TF_REQ_TSTMP | TF_RCVD_TSTMP)) ==
+	    (TF_REQ_TSTMP | TF_RCVD_TSTMP) &&
+	    rbbr->cycle_bytes_rcvd >= rbbr_action_bytes(tp, rtts)) {
+		return true;
+	}
+
+	if (rbbr->cycle_measure_ts != 0) {
+		return (now - rbbr->cycle_measure_ts) >=
+		    rbbr_action_duration_ms(tp, rtts);
+	}
+	return (now - start_ts) >= (uint32_t)rbbr_probe_cycle_duration;
 }
 
