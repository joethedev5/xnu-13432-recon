-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: rbbr_compute_jitter_stats_and_reset");
+	struct tcp_rbbr_state *rbbr = tp->t_rbbr_state;
+	uint16_t n = rbbr->rtt_sample_count;
+
+	if (n == 0) {
+		if (rbbr->delay_threshold == 0) {
+			rbbr->delay_threshold = 100;
+		}
+		return;
+	}
+
+	rbbr->median_rtt = rbbr_get_rtt_median(rbbr);
+
+	for (uint16_t i = 0; i < n; i++) {
+		int32_t diff = (int32_t)(rbbr->rtt_samples[i] -
+		    rbbr->median_rtt);
+		rbbr->rtt_samples[i] = (uint32_t)abs(diff);
+	}
+
+	rbbr->rtt_sorted = false;
+	rbbr->rtt_mad = rbbr_median_of_deviations(rbbr->rtt_samples, n);
+	rbbr->delay_threshold = rbbr->median_rtt +
+	    rbbr_delay_thresh_mad_mult * rbbr->rtt_mad +
+	    rbbr_target_delay_ms;
+
+	rbbr_reset_rtt_samples(tp);
 }
 
