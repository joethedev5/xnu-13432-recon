 osfmk/vm/vm_cow_defeatured_telemetry.c | 187 ++++++++++++++++++++++---
 osfmk/vm/vm_cow_defeatured_telemetry.h |  50 +++++++
 3 files changed, 230 insertions(+), 22 deletions(-)
 create mode 100644 osfmk/vm/vm_cow_defeatured_telemetry.h

