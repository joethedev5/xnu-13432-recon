+/* bsd/netinet/tcp_mss.c:142 */
+static unsigned int
+get_maxmtu(struct rtentry *rt)
+{
+	unsigned int maxmtu = 0;
+
+	RT_LOCK_ASSERT_NOTHELD(rt);
+
+	RT_LOCK(rt);
+
+	if (rt_key(rt)->sa_family == AF_INET6) {
+		maxmtu = tcp_maxmtu6(rt);
+	} else {
+		maxmtu = tcp_maxmtu(rt);
+	}
+
+	RT_UNLOCK(rt);
+
+	return maxmtu;
