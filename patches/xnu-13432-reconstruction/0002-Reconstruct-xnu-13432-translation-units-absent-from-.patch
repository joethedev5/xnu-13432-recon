+	if (ecn_flags & TE_ECN_MODE_ENABLE) {
+		return true;
+	}
+	if (ecn_flags & TE_ECN_MODE_DISABLE) {
+		return false;
+	}
+
+	/*
+	 * System wide settings come last
+	 */
+	if (tcp_ecn == 1) {
+		return true;
+	} else {
+		return false;
+	}
+}
