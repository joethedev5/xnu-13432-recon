-			if (sblk_start == found_seg->start_seq) {
-				/*
-				 * We are done with this SACK block.
-				 * Move the start of existing segment
-				 */
-				found_seg->start_seq = sblk_end;
-				break;
-			}
-
-			if (SEQ_GT(sblk_start, found_seg->start_seq)) {
