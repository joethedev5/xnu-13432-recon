-	if (seg->flags & TCP_RACK_RETRANSMITTED) {
-		if (seg->flags & TCP_SEGMENT_LOST) {
-			/*
-			 * If the segment is not considered lost, we don't clear
-			 * retransmitted as it might still be in flight. The ONLY time
