-			seg->flags &= ~(TCP_SEGMENT_LOST);
-			if (tp->bytes_lost < seg_len) {
-				os_log_error(tcp_log_handle, "bytes_lost (%u) can't be smaller "
-				    "than already lost segment length (%u)", tp->bytes_lost, seg_len);
-			}
