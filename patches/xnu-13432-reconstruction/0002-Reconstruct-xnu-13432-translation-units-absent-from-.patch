--- /dev/null
+++ b/bsd/netinet/tcp_ack.c
@@ -0,0 +1,205 @@
+/*
+ * Reconstruction of bsd/netinet/tcp_ack.c from the xnu-13432 reference kernel.
+ *
+ * Function signatures and ordering are derived from the KDK 27.0.1
+ * DWARF.  Functions marked RECON were moved from the public xnu source
+ * when the reference kernel placed them in this file; bodies marked
+ * "body not recovered" are still stubs.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+
+#define RECON_BSD_NETINET_TCP_ACK_C 1
+
+/* bsd/netinet/tcp_ack.c:91 */
+static uint32_t
+tcp_packets_this_ack(struct tcpcb *tp, uint32_t acked)
+{
+	return acked / tp->t_maxseg +
+	       (((acked % tp->t_maxseg) != 0) ? 1 : 0);
+}
+
+/* bsd/netinet/tcp_ack.c:105 */
+static boolean_t
+tcp_is_ack_ratelimited(struct tcpcb *tp)
+{
+	boolean_t ret = TRUE;
+	uint32_t now = tcp_now;
+	int32_t diff = 0;
+
+	diff = timer_diff(now, 0, tp->t_challengeack_last, 0);
+	/* If it is first time or diff > 1000ms,
+	 * update the challengeack_last and reset the
+	 * current count of ACKs
+	 */
+	if (tp->t_challengeack_last == 0 || diff >= 1000) {
+		tp->t_challengeack_last = now;
+		tp->t_challengeack_count = 0;
