From c4a029d225614aa0ba2e6f2707d3c14f87e9266f Mon Sep 17 00:00:00 2001
From: joethedev5 <deepsbx1@proton.me>
Date: Wed, 25 Nov 2026 03:05:31 +0000
Subject: [PATCH 23/41] Reconstruct the ECN handshake and feedback paths

Recover 16 of the 26 tcp_ecn.c stubs from the reference disassembly:

- tcp_ecn_process_syn and tcp_accecn_process_ip_ecn: the server-side
  SYN ACE decoding, with the ip_ecn-to-TE_ACE_SETUP_* mapping.
- tcp_ecn_process_synack, tcp_accecn_process_last_ack: the client-side
  SYN-ACK and last-ACK state machines, including the 13432-only
  TE_SEND_ECT1 (0x08000000) branches that turn ECT1/CE feedback into
  success and non-ECT/ECT0 feedback into mangling.
- tcp_ecn_send_flags_on_syn, tcp_ecn_syn_respond, tcp_ecn_synack_respond:
  SYN/SYN-ACK ACE setup, including the reference's decision to set
  TE_SENDIPECT already on an L4S AccECN SYN.
- tcp_ecn_update_counters, tcp_ecn_ip_feedback: receive-side IP-ECN
  accounting (the 13432 helper no longer takes an inpcb), window checks
  and ACE-bleaching detection.
- tcp_accecn_feedback, tcp_classic_ecn_feedback, tcp_ecn_feedback: the
  ACK feedback dispatcher, classic ECE fast-recovery entry and the
  AccECN packet-count/options path.
- tcp_classic_ecn_set_flags, tcp_accecn_set_ace_flags, tcp_ecn_set_flags:
  CWR/ECE emission and ACE field encoding from r.cep.
- tcp_accecn_add_option: the AccECN option writer, relocated from the
  public tcp_output.c text and renamed to the 13432 symbol.

tcp_var.h gains TE_SEND_ECT1 (0x08000000) for the new L4S ECT1 state.

Remaining explicit stubs: 243.

Authored-By: joethedev5 <joeshmo@nunya.com>
---
 bsd/netinet/tcp_ecn.c | 760 ++++++++++++++++++++++++++++++++++++++++--
 bsd/netinet/tcp_var.h |   1 +
 2 files changed, 727 insertions(+), 34 deletions(-)

diff --git a/bsd/netinet/tcp_ecn.c b/bsd/netinet/tcp_ecn.c
index 53ff1a5da..473aab549 100644
--- a/bsd/netinet/tcp_ecn.c
+++ b/bsd/netinet/tcp_ecn.c
@@ -23,16 +23,49 @@ uint32_t tcp_ecn_ce_heur_skipped;
 void
 tcp_accecn_process_ip_ecn(struct tcpcb * tp, uint8_t ip_ecn)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_accecn_process_ip_ecn");
+	switch (ip_ecn) {
+	case IPTOS_ECN_NOTECT:
+		tp->ecn_flags |= TE_ACE_SETUP_NON_ECT;
+		break;
+	case IPTOS_ECN_ECT1:
+		tp->ecn_flags |= TE_ACE_SETUP_ECT1;
+		break;
+	case IPTOS_ECN_ECT0:
+		tp->ecn_flags |= TE_ACE_SETUP_ECT0;
+		break;
+	case IPTOS_ECN_CE:
+		tp->ecn_flags |= TE_ACE_SETUP_CE;
+		break;
+	default:
+		break;
+	}
 }
 
 /* bsd/netinet/tcp_ecn.c:84 */
 void
 tcp_ecn_process_syn(struct tcpcb * tp, int ace_flags, uint8_t ip_ecn)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_ecn_process_syn");
+	if (ace_flags == 0) {
+		/* No ECN */
+		tp->t_server_accecn_state = tcp_connection_server_no_ecn_requested;
+		return;
+	}
+	if (ace_flags == (TH_CWR | TH_ECE)) {
+		/* Legacy ECN-setup */
+		tp->ecn_flags |= (TE_SETUPRECEIVED | TE_SENDIPECT);
+		tp->t_server_accecn_state = tcp_connection_server_classic_ecn_requested;
+		return;
+	}
+	if (!tp->l4s_enabled) {
+		return;
+	}
+	tcp_accecn_process_ip_ecn(tp, ip_ecn);
+	tp->ecn_flags |= TE_ACE_SETUPRECEIVED;
+
+	/* Initialize ECT byte counter to 1 to distinguish zeroing of options */
+	tp->t_aecn.t_rcv_ect1_bytes = tp->t_aecn.t_rcv_ect0_bytes = 1;
+	tp->t_aecn.t_snd_ect1_bytes = tp->t_aecn.t_snd_ect0_bytes = 1;
+	tp->t_server_accecn_state = tcp_connection_server_accurate_ecn_requested;
 }
 
 /* bsd/netinet/tcp_ecn.c:116 */
@@ -61,42 +94,473 @@ tcp_ecn_update_heuristics_synack(struct tcpcb * tp)
 
 /* bsd/netinet/tcp_ecn.c:265 */
 void
-tcp_ecn_process_synack(struct tcpcb * tp, struct tcpopt * to, int thflags, int ace_flags, uint8_t ip_ecn, uint32_t tlen, uint32_t segment_count)
+tcp_ecn_process_synack(struct tcpcb * tp, struct tcpopt * to, int thflags,
+    int ace_flags, uint8_t ip_ecn, uint32_t tlen, uint32_t segment_count)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_ecn_process_synack");
+	if ((thflags & (TH_ECE | TH_CWR)) == TH_ECE) {
+		/* Receiving Any|0|1 is classic ECN-setup SYN-ACK */
+		tp->ecn_flags |= TE_SETUPRECEIVED;
+		if (TCP_ECN_ENABLED(tp)) {
+			tcp_heuristic_ecn_success(tp);
+			tcpstat.tcps_ecn_client_success++;
+		}
+
+		if (tp->ecn_flags & TE_ACE_SETUPSENT) {
+			/*
+			 * Sent AccECN SYN but received classic ECN SYN-ACK.
+			 * Set classic ECN related flags.
+			 */
+			tp->ecn_flags |= (TE_SETUPSENT | TE_SENDIPECT);
+			tp->ecn_flags &= ~TE_ACE_SETUPSENT;
+			if (tp->t_client_accecn_state ==
+			    tcp_connection_client_accurate_ecn_feature_enabled) {
+				tp->t_client_accecn_state =
+				    tcp_connection_client_classic_ecn_available;
+			}
+		}
+	} else if (tp->l4s_enabled && ace_flags != 0 && ace_flags != TH_ACE) {
+		uint32_t ecn_flags;
+
+		/* Initialize sender side packet & byte counters */
+		tp->t_aecn.t_snd_ce_packets = 5;
+		tp->t_aecn.t_snd_ect1_bytes = tp->t_aecn.t_snd_ect0_bytes = 1;
+		tp->t_aecn.t_snd_ce_bytes = 0;
+
+		ecn_flags = tp->ecn_flags;
+		switch (ace_flags) {
+		case (0 | TH_CWR | 0):
+			/*
+			 * Non-ECT SYN was delivered.  The reference treats
+			 * this as mangling and stops sending IP ECT.
+			 */
+			tp->ecn_flags = (ecn_flags & ~TE_SENDIPECT) |
+			    TE_ACE_FINAL_ACK_3WHS | TE_ACE_SETUPRECEIVED;
+			tcpstat.tcps_ecn_ace_syn_not_ect++;
+			tp->t_client_accecn_state =
+			    tcp_connection_client_accurate_ecn_negotiation_success_ect_mangling_detected;
+			break;
+		case (0 | TH_CWR | TH_ECE):
+			/* ECT1 SYN was delivered */
+			tp->ecn_flags = ecn_flags | TE_ACE_FINAL_ACK_3WHS |
+			    TE_ACE_SETUPRECEIVED | TE_SENDIPECT;
+			tcpstat.tcps_ecn_ace_syn_ect1++;
+			tp->t_client_accecn_state =
+			    tcp_connection_client_accurate_ecn_negotiation_success;
+			break;
+		case (TH_AE | 0 | 0):
+			/* ECT0 SYN was delivered, mangling detected */
+			tp->ecn_flags = (ecn_flags & ~TE_SENDIPECT) |
+			    TE_ACE_FINAL_ACK_3WHS | TE_ACE_SETUPRECEIVED;
+			tcpstat.tcps_ecn_ace_syn_ect0++;
+			tp->t_client_accecn_state =
+			    tcp_connection_client_accurate_ecn_negotiation_success_ect_mangling_detected;
+			break;
+		case (TH_AE | TH_CWR | 0):
+			/* CE SYN was delivered */
+			tp->ecn_flags = ecn_flags | TE_ACE_FINAL_ACK_3WHS |
+			    TE_ACE_SETUPRECEIVED | TE_SENDIPECT;
+			tp->t_client_accecn_state =
+			    tcp_connection_client_accurate_ecn_negotiation_success;
+			if (tp->t_maxseg != 0) {
+				tp->snd_cwnd = 2 * tp->t_maxseg;
+			}
+			tcpstat.tcps_ecn_ace_syn_ce++;
+			break;
+		default:
+			/* Unused values for forward compatibility */
+			tp->ecn_flags = (ecn_flags & ~TE_SENDIPECT) |
+			    TE_ACE_FINAL_ACK_3WHS;
+			break;
+		}
+		tcp_set_accurate_ecn(tp);
+
+		if (TCP_ECN_ENABLED(tp)) {
+			tcp_heuristic_ecn_success(tp);
+			tcpstat.tcps_ecn_client_success++;
+		}
+		/*
+		 * A TCP client in AccECN mode MUST feed back which of the 4
+		 * possible values of the IP-ECN field was received in the
+		 * SYN/ACK.  Initialize the receive counters first.
+		 */
+		tp->t_aecn.t_rcv_ce_packets = 5;
+		tp->t_aecn.t_rcv_ect0_bytes = tp->t_aecn.t_rcv_ect1_bytes = 1;
+		tp->t_aecn.t_rcv_ce_bytes = 0;
+
+		/* Increment packet & byte counters based on IP-ECN */
+		tcp_ecn_update_counters(tp, tlen, segment_count, ip_ecn);
+		switch (ip_ecn) {
+		case IPTOS_ECN_NOTECT:
+			/* Not-ECT SYN-ACK was received */
+			tp->ecn_flags |= TE_ACE_SETUP_NON_ECT;
+			break;
+		case IPTOS_ECN_ECT1:
+			/* ECT1 SYN-ACK was received */
+			tp->ecn_flags |= TE_ACE_SETUP_ECT1;
+			break;
+		case IPTOS_ECN_ECT0:
+			/* ECT0 SYN-ACK was received */
+			tp->ecn_flags |= TE_ACE_SETUP_ECT0;
+			break;
+		case IPTOS_ECN_CE:
+			/* CE SYN-ACK was received */
+			tp->ecn_flags |= TE_ACE_SETUP_CE;
+			break;
+		}
+		/* Update the time for this newly received SYN-ACK */
+		if ((to->to_flags & TOF_TS) != 0 && to->to_tsecr != 0 &&
+		    (tp->t_last_ack_tsecr == 0 ||
+		    (int32_t)(to->to_tsecr - tp->t_last_ack_tsecr) >= 0)) {
+			tp->t_last_ack_tsecr = to->to_tsecr;
+		}
+	} else {
+		if ((tp->ecn_flags & (TE_SETUPSENT | TE_ACE_SETUPSENT)) &&
+		    tp->t_rxtshift == 0) {
+			tcp_heuristic_ecn_success(tp);
+			tcpstat.tcps_ecn_not_supported++;
+		}
+		if (((tp->ecn_flags & TE_SETUPSENT) != 0 && tp->t_rxtshift == 1) ||
+		    ((tp->ecn_flags & TE_ACE_SETUPSENT) != 0 && tp->t_rxtshift == 2)) {
+			/*
+			 * The SYN ECN option was likely dropped at the
+			 * network; check the ACK for the retransmission.
+			 */
+			tcp_heuristic_ecn_loss(tp);
+		}
+
+		/* non-ECN-setup SYN-ACK */
+		tp->ecn_flags &= ~TE_SENDIPECT;
+		/*
+		 * If the Accurate ECN SYN was retransmitted twice and a
+		 * non-ECN SYN-ACK was received, consider AccECN blackholed.
+		 */
+		if ((tp->ecn_flags & TE_LOST_SYN) && tp->t_rxtshift <= 2 &&
+		    tp->t_client_accecn_state ==
+		    tcp_connection_client_accurate_ecn_feature_enabled) {
+			tp->t_client_accecn_state =
+			    tcp_connection_client_accurate_ecn_negotiation_blackholed;
+		}
+		if (tp->t_client_accecn_state ==
+		    tcp_connection_client_accurate_ecn_feature_enabled) {
+			tp->t_client_accecn_state =
+			    tcp_connection_client_ecn_not_available;
+		}
+	}
 }
 
 /* bsd/netinet/tcp_ecn.c:290 */
 void
 tcp_accecn_process_last_ack(struct tcpcb * tp, struct tcpopt * to, uint32_t tlen, uint16_t ace_flags, _Bool syn_cookie_processed)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_accecn_process_last_ack");
+	if (syn_cookie_processed) {
+		/* Set AccECN and L4S flags as if these were negotiated successfully. */
+		if (tp->l4s_enabled) {
+			tp->ecn_flags |= (TE_SEND_ECT1 | TE_ACC_ECN_ON |
+			    TE_SENDIPECT);
+			tp->accurate_ecn_on = true;
+		}
+		tp->t_aecn.t_rcv_ce_packets = 5;
+		tp->t_aecn.t_snd_ce_packets = 5;
+		/* Initialize CE byte counter to 0 */
+		tp->t_aecn.t_rcv_ce_bytes = tp->t_aecn.t_snd_ce_bytes = 0;
+		/* Initialize ECT byte counter to 1 to distinguish zeroing of options */
+		tp->t_aecn.t_rcv_ect1_bytes = tp->t_aecn.t_rcv_ect0_bytes = 1;
+		tp->t_aecn.t_snd_ect1_bytes = tp->t_aecn.t_snd_ect0_bytes = 1;
+	}
+
+	if (tlen == 0 && to->to_nsacks == 0) {
+		/*
+		 * ACK for SYN-ACK reflects the state (ECN) in which SYN-ACK
+		 * packet was delivered.  Use Table 4 of Accurate ECN draft to
+		 * decode only when a pure ACK with no SACK block is received.
+		 * 0|0|0 will fail Accurate ECN negotiation and disable ECN.
+		 */
+		switch (ace_flags) {
+		case (0 | TH_CWR | 0):
+			/* Non-ECT SYN-ACK was delivered */
+			tp->t_aecn.t_snd_ce_packets = 5;
+			if (tp->ecn_flags & TE_SEND_ECT1) {
+				/* We sent ECT1, so non-ECT indicates mangling */
+				tp->ecn_flags &= ~TE_SENDIPECT;
+				if (tp->t_server_accecn_state ==
+				    tcp_connection_server_accurate_ecn_requested ||
+				    syn_cookie_processed) {
+					tp->t_server_accecn_state =
+					    tcp_connection_server_accurate_ecn_negotiation_success_ect_mangling_detected;
+				}
+			} else if (tp->t_server_accecn_state ==
+			    tcp_connection_server_accurate_ecn_requested ||
+			    syn_cookie_processed) {
+				tp->t_server_accecn_state =
+				    tcp_connection_server_accurate_ecn_negotiation_success;
+			}
+			break;
+		case (0 | TH_CWR | TH_ECE):
+			/* ECT1 SYN-ACK was delivered */
+			tp->t_aecn.t_snd_ce_packets = 5;
+			if (tp->ecn_flags & TE_SEND_ECT1) {
+				if (tp->t_server_accecn_state ==
+				    tcp_connection_server_accurate_ecn_requested ||
+				    syn_cookie_processed) {
+					tp->t_server_accecn_state =
+					    tcp_connection_server_accurate_ecn_negotiation_success;
+				}
+			} else {
+				/* Mangling detected */
+				tp->ecn_flags &=
+				    ~(TE_SEND_ECT1 | TE_SENDIPECT);
+				if (tp->t_server_accecn_state ==
+				    tcp_connection_server_accurate_ecn_requested ||
+				    syn_cookie_processed) {
+					tp->t_server_accecn_state =
+					    tcp_connection_server_accurate_ecn_negotiation_success_ect_mangling_detected;
+				}
+			}
+			break;
+		case (TH_AE | 0 | 0):
+			/* ECT0 SYN-ACK was delivered, mangling detected */
+			tp->t_aecn.t_snd_ce_packets = 5;
+			tp->ecn_flags &= ~TE_SENDIPECT;
+			if (tp->t_server_accecn_state ==
+			    tcp_connection_server_accurate_ecn_requested ||
+			    syn_cookie_processed) {
+				tp->t_server_accecn_state =
+				    tcp_connection_server_accurate_ecn_negotiation_success_ect_mangling_detected;
+			}
+			break;
+		case (TH_AE | TH_CWR | 0):
+			/*
+			 * CE SYN-ACK was delivered, even though mangling
+			 * happened, CE could indicate congestion at a node
+			 * after mangling occurred.  Set cwnd to 2 segments.
+			 */
+			tp->t_aecn.t_snd_ce_packets = 6;
+			if (tp->t_maxseg != 0) {
+				tp->snd_cwnd = 2 * tp->t_maxseg;
+			}
+			if (tp->ecn_flags & TE_SEND_ECT1) {
+				if (tp->t_server_accecn_state ==
+				    tcp_connection_server_accurate_ecn_requested ||
+				    syn_cookie_processed) {
+					tp->t_server_accecn_state =
+					    tcp_connection_server_accurate_ecn_negotiation_success;
+				}
+			} else {
+				tp->ecn_flags &=
+				    ~(TE_SEND_ECT1 | TE_SENDIPECT);
+				if (tp->t_server_accecn_state ==
+				    tcp_connection_server_accurate_ecn_requested ||
+				    syn_cookie_processed) {
+					tp->t_server_accecn_state =
+					    tcp_connection_server_accurate_ecn_negotiation_success_ect_mangling_detected;
+				}
+			}
+			break;
+		case (0 | 0 | 0):
+			/* Disable ECN, as ACE fields were zeroed */
+			tp->ecn_flags &= ~(TE_SETUPRECEIVED | TE_SENDIPECT |
+			    TE_SENDCWR | TE_ACE_SETUPRECEIVED);
+			tp->accurate_ecn_on = false;
+			/*
+			 * Since last ACK has no ECN flag set and TE_LOST_SYNACK
+			 * is set, this is in response to the second (non-ECN
+			 * setup) SYN-ACK retransmission.  In such a case, we
+			 * assume that AccECN SYN-ACK was blackholed.
+			 */
+			if ((tp->ecn_flags & TE_LOST_SYNACK) &&
+			    tp->t_rxtshift <= 2 &&
+			    (tp->t_server_accecn_state ==
+			    tcp_connection_server_classic_ecn_requested ||
+			    tp->t_server_accecn_state ==
+			    tcp_connection_server_accurate_ecn_requested ||
+			    syn_cookie_processed)) {
+				tp->t_server_accecn_state =
+				    tcp_connection_server_accurate_ecn_negotiation_blackholed;
+			}
+			/*
+			 * SYN-ACK hasn't been retransmitted twice yet, so this
+			 * could likely mean bleaching of ACE on the path from
+			 * client to server on last ACK.
+			 */
+			if (tp->t_server_accecn_state ==
+			    tcp_connection_server_accurate_ecn_requested) {
+				tp->t_server_accecn_state =
+				    tcp_connection_server_accurate_ecn_ace_bleaching_detected;
+			}
+			break;
+		default:
+			/* Unused values for forward compatibility */
+			tp->t_aecn.t_snd_ce_packets = 5;
+			tp->ecn_flags &= ~TE_SENDIPECT;
+			break;
+		}
+		/* Update the time for this newly received last ACK */
+		if ((to->to_flags & TOF_TS) != 0 && to->to_tsecr != 0 &&
+		    (tp->t_last_ack_tsecr == 0 ||
+		    TSTMP_GEQ(to->to_tsecr, tp->t_last_ack_tsecr))) {
+			tp->t_last_ack_tsecr = to->to_tsecr;
+		}
+	} else if (to->to_nsacks == 0) {
+		/*
+		 * If the 3rd ACK is lost, we won't receive the last ACK
+		 * encoding.  We will move the server to AccECN mode
+		 * regardless.
+		 */
+		tp->t_aecn.t_snd_ce_packets = 5;
+		if (tp->t_server_accecn_state ==
+		    tcp_connection_server_accurate_ecn_requested ||
+		    syn_cookie_processed) {
+			tp->t_server_accecn_state =
+			    tcp_connection_server_accurate_ecn_negotiation_success;
+		}
+	}
+	tp->ecn_flags &= ~TE_SEND_ECT1;
+	tp->t_aecn.accecn_processed = true;
 }
 
 /* bsd/netinet/tcp_ecn.c:442 */
 _Bool
 tcp_ecn_send_flags_on_syn(struct tcpcb * tp)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_ecn_send_flags_on_syn");
+	/* We allow Accurate ECN negotiation on the first retransmission too */
+	bool send_on_first_retrans = (tp->ecn_flags & TE_ACE_SETUPSENT) &&
+	    (tp->t_rxtshift <= 1);
+
+	return !(tp->ecn_flags & (TE_SETUPSENT | TE_ACE_SETUPSENT)) ||
+	       send_on_first_retrans;
 }
 
 /* bsd/netinet/tcp_ecn.c:452 */
 uint16_t
 tcp_ecn_syn_respond(struct tcpcb * tp, uint16_t thflags)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_ecn_syn_respond");
+	if (tcp_ecn_send_flags_on_syn(tp)) {
+		if (tp->l4s_enabled) {
+			/*
+			 * We are negotiating AccECN in SYN.  The reference
+			 * starts sending IP ECT already on the SYN.
+			 */
+			thflags |= TH_ACE;
+			tp->ecn_flags |= (TE_ACE_SETUPSENT | TE_SENDIPECT);
+		} else {
+			/*
+			 * Setting TH_ECE and TH_CWR makes this an
+			 * ECN-setup SYN.
+			 */
+			thflags |= (TH_ECE | TH_CWR);
+			tp->ecn_flags |= (TE_SETUPSENT | TE_SENDIPECT);
+		}
+		tcpstat.tcps_ecn_client_setup++;
+		tp->ecn_flags |= TE_CLIENT_SETUP;
+	} else {
+		/*
+		 * We sent an ECN-setup SYN but it was dropped.  Fall back
+		 * to non-ECN and clear the IP ECT send flag.
+		 */
+		tcpstat.tcps_ecn_lost_syn++;
+		tp->ecn_flags &= ~TE_SENDIPECT;
+		tp->ecn_flags |= TE_LOST_SYN;
+	}
+	return thflags;
 }
 
 /* bsd/netinet/tcp_ecn.c:500 */
 uint16_t
 tcp_ecn_synack_respond(struct tcpcb * tp, uint16_t thflags)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_ecn_synack_respond");
+	/* Server received either legacy or Accurate ECN setup SYN */
+	if (tp->ecn_flags & (TE_SETUPRECEIVED | TE_ACE_SETUPRECEIVED)) {
+		if (tcp_ecn_send_flags_on_syn(tp)) {
+			if (tp->l4s_enabled &&
+			    (tp->ecn_flags & TE_ACE_SETUPRECEIVED)) {
+				/*
+				 * Accurate ECN mode is on.  Initialize packet
+				 * and byte counters for the server sending
