-
-#endif /* XNU13432_IOKIT_KERNEL_IOANALYTICS_H */
+
+typedef struct {
+} IOAnalyticsPeriodicEvent;
+
+typedef void (^IOAnalyticsBootHandler)(IOAnalyticsBootEvent * event);
+typedef void (^IOAnalyticsPeriodicHandler)(IOAnalyticsPeriodicEvent * event);
+
+class IOAnalytics {
+public:
+	/*
+	 * Initializes the analytics locks and the periodic thread call.
+	 * Called once during kernel startup.
+	 */
+	static void initialize(void);
+
+	/*
+	 * Registers a handler that contributes the boot analytics record.
+	 * The handler is called once by completeBoot(); it must fill the
+	 * IOAnalyticsBootEvent it is given.  Returns kIOReturnBadArgument
+	 * for a null handler, kIOReturnUnsupported after boot completion
+	 * and kIOReturnNoMemory when the entry cannot be allocated.
+	 */
+
+	static IOReturn registerBootInfoUpdate(IOAnalyticsBootHandler handler);
+
+	/*
+	 * Registers a handler for the periodic analytics event.  Returns
+	 * the entry that must be passed to deregisterPeriodicInfoUpdate,
+	 * or NULL when the handler is null or the entry cannot be
+	 * allocated.  The first registration schedules the periodic
+	 * updates.
+	 */
+
+	static void * registerPeriodicInfoUpdate(IOAnalyticsPeriodicHandler handler);
+
+	/*
+	 * Removes a periodic handler registered earlier.  Returns
+	 * kIOReturnBadArgument when the entry is not registered and
+	 * kIOReturnSuccess once it has been removed and freed.
+	 */
+
+	static IOReturn deregisterPeriodicInfoUpdate(void * entry);
+
+	/*
+	 * Sends the boot event once; later calls do nothing.
+	 */
+	static void completeBoot(void);
+	static void schedulePeriodicUpdate(void);
+	static void cancelPeriodicUpdate(void);
+	static void sendPeriodic(void * arg0, void * arg1);
+};
+
+#endif /* __cplusplus */
+
+#endif /* _IOKIT_IOANALYTICS_H */
