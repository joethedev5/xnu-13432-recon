+ */
+
+/*
+ * bootTimeMS             Time from boot to the completion report.
+ * numConfigThreads       Threads created while configuring the system.
+ * numMatchedServices     Services matched by the IOKit match process.
+ * totalServiceWaitTimeMS Sum of the waits of services for providers.
+ * totalModuleStallTimeMS Sum of the kext module stall times.
+ */
+
+/*
+ * The record is delivered to the registered handlers by pointer; they
+ * fill the fields in place.  The handlers run only once, when boot
+ * completes.
  */
-#ifndef XNU13432_IOKIT_KERNEL_IOANALYTICS_H
-#define XNU13432_IOKIT_KERNEL_IOANALYTICS_H
 
 typedef struct {
 	uint64_t bootTimeMS;
@@ -14,17 +47,58 @@ typedef struct {
 	uint64_t totalServiceWaitTimeMS;
 	uint64_t totalModuleStallTimeMS;
 } IOAnalyticsBootEvent;
-typedef struct anon IOAnalyticsPeriodicEvent;
-typedef struct anon *IOAnalyticsBootHandler;
-typedef struct anon *IOAnalyticsPeriodicHandler;
