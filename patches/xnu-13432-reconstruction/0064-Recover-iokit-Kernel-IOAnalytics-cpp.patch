+ * Function signatures, record layouts and statement lines are derived
+ * from the KDK 27.0.1 DWARF and cross-checked against the RELEASE and
+ * kasan vmapple kernels.  The original comment text and the include
+ * list are not recoverable from the kernel image.
  */
-#include <IOKit/IOService.h>
+
+#include "IOAnalytics.h"
 #include <IOKit/IOLib.h>
-#include <sys/systm.h>
-#include <IOKit/IOAnalytics.h>
+#include <IOKit/IOLocks.h>
+#include <kern/assert.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <kern/zalloc.h>
+#include <libkern/Block.h>
+#include <libkern/coreanalytics/coreanalytics.h>
+#include <mach/mach_time.h>
+#include <sys/queue.h>
+
+/*
+ * The boot event carries the record collected by the boot handlers.
+ * The event name and the field names below are also the CoreAnalytics
+ * format string of the event.
+ */
+
+/*
+ * The periodic event is currently sent with no fields, but the
+ * handlers are still called on every periodic tick.
+ */
+CA_EVENT(IOAnalyticsBoot,
+	CA_INT, bootTimeMS,
+	CA_INT, numConfigThreads,
+	CA_INT, numMatchedServices,
+	CA_INT, totalServiceWaitTimeMS,
+	CA_INT, totalModuleStallTimeMS);
 
-#define RECON_IOKIT_KERNEL_IOANALYTICS_CPP 1
+/* The periodic event has no fields of its own. */
+CA_EVENT(IOAnalyticsPeriodic);
+
+/* The payload types generated by the two CA_EVENT definitions. */
+typedef CA_EVENT_TYPE(IOAnalyticsBoot) IOAnalyticsBootData;
+typedef CA_EVENT_TYPE(IOAnalyticsPeriodic) IOAnalyticsPeriodicData;
+
+struct BootHandlerEntry {
+	SLIST_ENTRY(BootHandlerEntry) chain;
+	IOAnalyticsBootHandler handler;
+};
+struct PeriodicHandlerEntry {
+	SLIST_ENTRY(PeriodicHandlerEntry) chain;
+	IOAnalyticsPeriodicHandler handler;
+};
+
+static SLIST_HEAD(BootHandlerList, BootHandlerEntry) bootHandlers;
+static SLIST_HEAD(PeriodicHandlerList, PeriodicHandlerEntry) periodicHandlers;
+
+static bool bootCompleted;
+static lck_mtx_t * bootLock;
+static bool periodicEnabled;
+static lck_mtx_t * periodicLock;
+static thread_call_t periodicThreadCall;
 
-/* iokit/Kernel/IOAnalytics.cpp:68 */
 void
-initialize(void)
+IOAnalytics::initialize(void)
+{
+	bootLock = IOLockAlloc();
+	periodicLock = IOLockAlloc();
+
+	assert(bootLock);
+	assert(periodicLock);
+
+	SLIST_INIT(&bootHandlers);
+	SLIST_INIT(&periodicHandlers);
+
+	/* One-shot thread call that emits the periodic events. */
+	periodicThreadCall = thread_call_allocate_with_options(sendPeriodic, NULL, THREAD_CALL_PRIORITY_LOW, THREAD_CALL_OPTIONS_ONCE);
+
+	assert(periodicThreadCall);
+}
+
+IOReturn
+IOAnalytics::registerBootInfoUpdate(IOAnalyticsBootHandler handler)
+{
+	IOReturn ret = kIOReturnNoMemory;
+	BootHandlerEntry * entry;
+
+	if (!handler) {
+		return kIOReturnBadArgument;
+	}
+
+	/* No registrations are accepted once boot has completed. */
+	lck_mtx_lock(bootLock);
+
+	if (bootCompleted) {
+		ret = kIOReturnUnsupported;
+		goto out;
+	}
+
+	/* Allocate the entry and retain the handler block. */
+	entry = kalloc_type(BootHandlerEntry, Z_WAITOK);
+	if (entry == NULL) {
+		goto out;
+	}
+
+	entry->handler = Block_copy(handler);
+	SLIST_INSERT_HEAD(&bootHandlers, entry, chain);
+	ret = kIOReturnSuccess;
+out:
+	lck_mtx_unlock(bootLock);
+
+	return ret;
+}
+
+void *
+IOAnalytics::registerPeriodicInfoUpdate(IOAnalyticsPeriodicHandler handler)
+{
+	PeriodicHandlerEntry * entry;
+
+	if (!handler) {
+		return NULL;
+	}
+
+	entry = kalloc_type(PeriodicHandlerEntry, Z_WAITOK);
+	if (entry == NULL) {
+		return NULL;
+	}
+	entry->handler = Block_copy(handler);
+
+	lck_mtx_lock(periodicLock);
+	SLIST_INSERT_HEAD(&periodicHandlers, entry, chain);
+	if (!periodicEnabled) {
+		schedulePeriodicUpdate();
+	}
+
+	lck_mtx_unlock(periodicLock);
+
+	return entry;
+}
+
+IOReturn
+IOAnalytics::deregisterPeriodicInfoUpdate(void * entry)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: initialize");
+	bool found = false;
+	PeriodicHandlerEntry * listEntry, * listEntryTmp;
+
+	lck_mtx_lock(periodicLock);
+	SLIST_FOREACH_SAFE(listEntry, &periodicHandlers, chain, listEntryTmp) {
+		if (listEntry == entry) {
+			found = true;
+
+			SLIST_REMOVE(&periodicHandlers, listEntry, PeriodicHandlerEntry, chain);
+			Block_release(listEntry->handler);
+			kfree_type(PeriodicHandlerEntry, listEntry);
+			break;
+		}
+	}
+
+	/* Stop the periodic updates if this was the last handler. */
+	if (found && SLIST_EMPTY(&periodicHandlers)) {
+		cancelPeriodicUpdate();
+	}
+	lck_mtx_unlock(periodicLock);
+
+	return found ? kIOReturnSuccess : kIOReturnBadArgument;
 }
 
-/* iokit/Kernel/IOAnalytics.cpp:86 */
 void
-registerBootInfoUpdate(IOAnalyticsBootHandler handler)
+IOAnalytics::completeBoot(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: registerBootInfoUpdate");
+
+	BootHandlerEntry * entry;
+	IOAnalyticsBootEvent data = {};
+	ca_event_t event;
+	IOAnalyticsBootData * edata;
+
+	/* Report the boot only once. */
+	lck_mtx_lock(bootLock);
+	if (bootCompleted) {
+		lck_mtx_unlock(bootLock);
+		return;
+	}
+	bootCompleted = true;
+	lck_mtx_unlock(bootLock);
+
+	event = CA_EVENT_ALLOCATE(IOAnalyticsBoot);
+	edata = (IOAnalyticsBootData *)event->data;
+
+	/* Let each handler contribute its fields. */
+	SLIST_FOREACH(entry, &bootHandlers, chain) {
+		entry->handler(&data);
+	}
+
+	/* Copy the collected record into the event payload. */
+	edata->bootTimeMS = data.bootTimeMS;
+	edata->numConfigThreads = data.numConfigThreads;
+	edata->numMatchedServices = data.numMatchedServices;
+	edata->totalServiceWaitTimeMS = data.totalServiceWaitTimeMS;
+	edata->totalModuleStallTimeMS = data.totalModuleStallTimeMS;
+
+	/* Send the event and release the handlers. */
+	core_analytics_send_event(event);
+
+	/* The handlers are only needed once. */
+	SLIST_FOREACH(entry, &bootHandlers, chain) {
+		/* Pop each entry before freeing it. */
+		SLIST_REMOVE_HEAD(&bootHandlers, chain);
+		Block_release(entry->handler);
+		kfree_type(BootHandlerEntry, entry);
+	}
 }
 
-/* iokit/Kernel/IOAnalytics.cpp:172 */
 void
-completeBoot(void)
+IOAnalytics::schedulePeriodicUpdate(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: completeBoot");
+	AbsoluteTime absolutePeriod;
+	nanoseconds_to_absolutetime(24 * 60 * 60 * NSEC_PER_SEC, &absolutePeriod);
+	AbsoluteTime deadline = mach_absolute_time() + absolutePeriod;
+
+	/* Schedule the next periodic update. */
+	thread_call_enter_delayed(periodicThreadCall, deadline);
+	periodicEnabled = true;
 }
 
-/* iokit/Kernel/IOAnalytics.cpp:217 */
 void
-schedulePeriodicUpdate(void)
+IOAnalytics::cancelPeriodicUpdate(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: schedulePeriodicUpdate");
+
+	thread_call_cancel(periodicThreadCall);
+	periodicEnabled = false;
 }
 
-/* iokit/Kernel/IOAnalytics.cpp:237 */
 void
-sendPeriodic(void * arg0, void * arg1)
+IOAnalytics::sendPeriodic(void * arg0, void * arg1)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: sendPeriodic");
+
+	PeriodicHandlerEntry * entry;
+	IOAnalyticsPeriodicEvent data = {};
+	ca_event_t event = CA_EVENT_ALLOCATE(IOAnalyticsPeriodic);
+	IOAnalyticsPeriodicData * edata = (IOAnalyticsPeriodicData *)event->data;
+
+	lck_mtx_lock(periodicLock);
+
+	if (!periodicEnabled) {
+		lck_mtx_unlock(periodicLock);
+		return;
+	}
+
+	/* Deliver the event to every registered handler. */
+	SLIST_FOREACH(entry, &periodicHandlers, chain) {
+		entry->handler(&data);
+	}
+
+	schedulePeriodicUpdate();
+
+	lck_mtx_unlock(periodicLock);
+
+	/* Send the periodic event and reschedule the thread call. */
+	(void)edata;
+
+	/* The event is delivered to the user-space analytics pipeline. */
+	core_analytics_send_event(event);
 }
