 }
 
 
+/*
+ * exec_handle_virtual_env_port_actions
+ *
+ * Description:	Install the virtual environment provided by a posix_spawn
+ *		port action.  Only a task holding the spawn entitlement may
+ *		provide one, and a process may only have one.
+ *
+ * Parameters:	proc_t				Child process
+ *		task_t				Parent task
+ *		ipc_port_t			Virtual environment port
+ *
+ * Returns:	0			Success
+ *		ENOENT			Virtual environments unavailable
+ *		EPERM			Missing entitlement
+ *		EEXIST			Process already has a virtual environment
+ *		EINVAL			Not a virtual environment port
+ */
+static errno_t
+exec_handle_virtual_env_port_actions(proc_t p, task_t old_task,
+    ipc_port_t virtual_env_port)
+{
+	virtual_env_t venv;
+
+	if (!virtual_env_is_available()) {
+		return ENOENT;
+	}
+	if (!IOTaskHasEntitlement(old_task,
+	    "com.apple.private.virtualenv.spawn")) {
+		return EPERM;
+	}
+	if (p->p_virtual_env != NULL) {
+		return EEXIST;
+	}
+
+	venv = convert_port_to_virtual_env(virtual_env_port);
+	if (venv == NULL) {
+		return EINVAL;
+	}
+
+	p->p_virtual_env = venv;
+	return 0;
+}
+
