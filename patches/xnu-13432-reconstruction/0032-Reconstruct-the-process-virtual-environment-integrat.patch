-		p->p_subsystem_root_path = subsystem_root_path;
-		subsystem_root_path = old_subsystem_root_path;
+		/* If a subsystem root was specified, create the child's virtual environment */
+		error = virtual_env_create_from_subsystem_root_path(
+		    subsystem_root_path, &p->p_virtual_env);
+		if (error != 0) {
+			goto bad;
+		}
 	}
 
 	p->p_crash_behavior = crash_behavior;
@@ -4797,9 +4862,6 @@ do_fork1:
 	p->p_crash_count = px_sa.psa_crash_count;
