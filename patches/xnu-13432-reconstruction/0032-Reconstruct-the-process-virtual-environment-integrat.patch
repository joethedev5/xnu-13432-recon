-	imgp->ip_subsystem_root_path = p->p_subsystem_root_path;
-
 	context.vc_thread = imgp->ip_new_thread;
 	context.vc_ucred = proc_ucred_unsafe(p);  /* in init */
 
@@ -4851,8 +4913,20 @@ do_fork1:
 		if (error != 0) {
 			goto bad;
 		}
+
+		if (port_actions.virtual_env_port != IPC_PORT_NULL) {
+			error = exec_handle_virtual_env_port_actions(p, old_task,
+			    port_actions.virtual_env_port);
+			if (error != 0) {
+				goto bad;
+			}
+		}
 	}
 
+	/* We'll need the subsystem root for setting up Apple strings */
+	imgp->ip_subsystem_root_path =
+	    virtual_env_get_subsystem_root_path(p->p_virtual_env);
+
 	/* Has spawn attr? */
 	if (imgp->ip_px_sa != NULL) {
 		/*
@@ -6050,7 +6124,8 @@ __mac_execve(proc_t p, struct __mac_execve_args *uap, int32_t *retval __unused)
 	context.vc_thread = imgp->ip_new_thread;
 	context.vc_ucred = kauth_cred_proc_ref(p);      /* XXX must NOT be kauth_cred_get() */
 
-	imgp->ip_subsystem_root_path = p->p_subsystem_root_path;
+	imgp->ip_subsystem_root_path =
+	    virtual_env_get_subsystem_root_path(p->p_virtual_env);
 
 	proc_transend(p, 0);
 	proc_signalend(p, 0);
