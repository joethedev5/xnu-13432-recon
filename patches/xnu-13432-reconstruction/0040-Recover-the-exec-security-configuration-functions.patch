 /* bsd/kern/kern_exec_security.c:259 */
 void
-imgact_setup_ipc_containment(struct image_params * imgp, load_result_t * load_result, task_t task, proc_t p)
+imgact_setup_ipc_containment(struct image_params *imgp,
+    load_result_t *load_result, task_t task, __unused proc_t p)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: imgact_setup_ipc_containment");
+	exec_security_advance_state(load_result,
+	    EXEC_SECURITY_STATE_IPC_CONTAINMENT_SETUP);
+
+	/* Pipe through the IPC containment vessel entitlement state from the load result */
+	if (load_result->is_ipc_containment_vessel) {
+		task_set_ipc_containment_vessel(task);
+
+		if (load_result->platform_binary) {
+			const char *webkit_prefix = "com.apple.WebKit.";
+			struct cs_blob *blob = csvnode_get_blob(imgp->ip_vp,
+			    imgp->ip_arch_offset);
+			const char *signing_id = blob ?
+			    csblob_get_identity(blob) : NULL;
+
+			if (signing_id && !strncmp(signing_id, webkit_prefix,
+			    strlen(webkit_prefix))) {
+				task_set_webkit(task);
+			} else {
+				task_clear_webkit(task);
+			}
+		}
+	} else {
+		task_clear_ipc_containment_vessel(task);
+	}
 }
 
 /* bsd/kern/kern_exec_security.c:290 */
 void
-imgact_setup_ipc_security_policy(struct image_params * imgp, load_result_t * load_result, task_t old_task, task_t new_task, vm_map_t map, proc_t p)
+imgact_setup_ipc_security_policy(struct image_params *imgp,
+    load_result_t *load_result, __unused task_t old_task, task_t new_task,
+    __unused vm_map_t map, proc_t p)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: imgact_setup_ipc_security_policy");
+	bool override = false;
+
+	imgact_set_platform_binary_flag(load_result, new_task, p);
+
+	/* Disable mach hardening for tasks which may load third-party plugins */
+#if XNU_TARGET_OS_OSX
+	if (override || (imgp->ip_flags & IMGPF_3P_PLUGINS)) {
+		task_disable_mach_hardening(new_task);
+	}
+#else
+	(void)override;
+#endif /* XNU_TARGET_OS_OSX */
 }
 
 /* bsd/kern/kern_exec_security.c:320 */
 void
 exec_setup_vfs_resolve_flags(task_t task)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: exec_setup_vfs_resolve_flags");
+	struct proc *p = get_bsdtask_info(task);
+	char *entitlement_string = IOTaskGetEntitlement(task,
+	    VFS_RESOLVE_FLAGS_ENTITLEMENT);
+
+	if (entitlement_string != NULL) {
+		char *endptr = NULL;
+		unsigned long value = strtoul(entitlement_string, &endptr, 10);
+
+		/*
+		 * Only accept fully parsed values; the entitlement controls the
+		 * fixed VFS path resolution flags for this process.
+		 */
+		if (entitlement_string != endptr &&
+		    *endptr == '\0') {
+			uint32_t resolve_flags = (uint32_t)value & 0x7ff;
+
+			proc_set_fixed_vfs_resolve_flags(p, resolve_flags);
+			p->p_vfs_resolve_flags |= resolve_flags;
+		}
+
+		kfree_data_addr(entitlement_string);
+	}
 }
