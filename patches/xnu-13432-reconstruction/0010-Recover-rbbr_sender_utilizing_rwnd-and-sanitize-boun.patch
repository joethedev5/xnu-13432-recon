 uint32_t
-rbbr_median_of_deviations(struct __bounds_safety::wide_ptr.indexable.50 deviations, uint16_t n)
+rbbr_median_of_deviations(uint32_t *deviations __counted_by(n), uint16_t n)
 {
 	/* RECON(13432): body not recovered from the reference kernel yet. */
 	panic("reconstructed stub: rbbr_median_of_deviations");
@@ -251,8 +252,41 @@ rbbr_process_probe_rwnd_cycle(struct tcpcb * tp, _Bool * utilized_out)
 _Bool
 rbbr_sender_utilizing_rwnd(struct tcpcb * tp)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: rbbr_sender_utilizing_rwnd");
+	struct tcp_rbbr_state *rbbr = tp->t_rbbr_state;
+	uint32_t now = tcp_now;
+	uint32_t median = rbbr->median_rtt;
+	uint32_t measure_ms;
+	uint64_t expected;
+	uint64_t cycle_rtt;
+	uint64_t utilization_pct;
+
+	if (rbbr->rtt_sample_count != 0) {
+		median = rbbr_get_rtt_median(rbbr);
+		if (median == 0) {
+			median = rbbr->median_rtt;
+		}
+	}
+	if (median == 0 || rbbr->win == 0 || rbbr->cycle_measure_ts == 0) {
+		return false;
+	}
+	measure_ms = now - rbbr->cycle_measure_ts;
+	expected = (uint64_t)rbbr->win * measure_ms;
+	if (expected < median) {
+		return true;
+	}
+	cycle_rtt = expected / median;
+	utilization_pct = rbbr->cycle_bytes_rcvd * 100 / cycle_rtt;
+	if (utilization_pct >= (uint64_t)rbbr_low_utilization_thresh) {
+		return true;
+	}
+	if (tcp_is_log_enabled(tp, TLEF_LOG)) {
+		tcp_log_bbr("rbbr_sender_utilizing_rwnd", 825, tp,
+		    "rbbr: low utilization bytes_rcvd=%llu expected=%llu "
+		    "measure_ms=%u win=%u cycle_rtt=%u median_rtt=%u",
+		    rbbr->cycle_bytes_rcvd, expected, measure_ms, rbbr->win,
+		    (uint32_t)cycle_rtt, median);
+	}
+	return false;
 }
 
