+static int
+sysctl_privacy_enhancements(struct sysctl_oid * oidp, void * arg1, int arg2, struct sysctl_req * req)
+{
+	/* Start from the value of the switch that is currently in force. */
+	int value;
+	int error;
+
+
+	value = net_rt_filter_cloned_routes;
+
+	error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error != 0) {
+		return error;
+	}
+	if (req->newptr == 0) {
+		return error;
+	}
+
+
+	net_rt_filter_cloned_routes = value;
+
+	dlil_lladdr_ckreq = value;
+
+	net_inet_hide_pcb_established = value;
+
+	NETOBS_LOG("privacy_enhancements sysctl changed to %d (filter_cloned_routes=%d, filter_mac_addresses=%d, hide_pcb_established=%d)",
+	    value, net_rt_filter_cloned_routes, dlil_lladdr_ckreq, net_inet_hide_pcb_established);
+
+	/*
+	 * All of the switches have been updated together.  The value
+	 * returned by sysctl_handle_int() is zero here: errors and the
+	 * read-only case returned early above.
+	 *
+	 * One write to privacy_enhancements turns all three filters on or
+	 * off as a unit.
+	 */
+	return error;
+}
