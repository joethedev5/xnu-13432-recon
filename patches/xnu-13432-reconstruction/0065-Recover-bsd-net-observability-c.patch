+SYSCTL_PROC(_net_observability, OID_AUTO, privacy_enhancements, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sysctl_privacy_enhancements, "I", "Primary switch for network privacy enhancements (sets filter_cloned_routes, filter_mac_addresses, hide_pcb_established)");
