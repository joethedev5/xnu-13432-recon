+/*
+ * The permission check shared by the socket and connection listing code.
+ * The caller supplies a short prefix (normally its source file name) that
+ * is prepended to the debug log messages.  The check is ordered from most
+ * to least privileged: root, lockdown mode, the observer entitlement,
+ * signed third-party applications, and finally the platform-binary
+ * parent chain.
+ *
+ * The caller holds a reference on proc for the duration of the call.
+ */
+bool
 net_check_observability_permission_impl(struct proc * proc, const char * log_prefix)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: net_check_observability_permission_impl");
+	/*
+	 * The root user can always observe the network.
+	 */
+	/*
+	 * proc_suser() returns 0 for the root user and an error for
+	 * everybody else.
+	 */
+	bool is_root = (proc_suser(proc) == 0);
+	if (is_root) {
+		NETOBS_LOG("%s root process, allowing access (proc=%s)\n", log_prefix, proc->p_comm);
+		return true;
+	}
+
+	task_t task = proc_task(proc);
+
+	/*
+	 * In lockdown mode the policy is stricter: only platform signed
+	 * binaries with a clean parent chain are allowed to observe the
+	 * network.  The observer entitlement is deliberately not honored
+	 * here: in lockdown mode a third-party binary must not be able to
+	 * observe the network even when it holds the entitlement.
+	 *
+	 * The chain walk is called with honor_entitlement = false, so an
+	 * entitled ancestor does not make the chain clean.
+	 */
+	if (get_lockdown_mode_state() != 0) {
+		if (task != NULL && task_get_platform_binary(task)) {
+			parent_chain_info_t info = {};
+			parent_chain_result_t chain_result =
+			    check_parent_chain(proc, false, &info);
+
+			if (chain_result == PARENT_CHAIN_CLEAN) {
+				NETOBS_LOG("%s lockdown mode: platform binary with clean parent chain, allowing access (proc=%s)\n", log_prefix, proc->p_comm);
+				return true;
+			}
+
+			NETOBS_LOG("%s lockdown mode: platform binary with non-clean parent chain (result=%d, untrusted=%s pid=%d), denying access (proc=%s)\n", log_prefix, chain_result, info.untrusted_name, info.untrusted_pid, proc->p_comm);
+			return false;
+		}
+
+		return false;
+	}
+
+	/*
+	 * Outside lockdown mode an entitled process is allowed to observe
+	 * the network.  The entitlement is checked on the task because only
+	 * the task carries the loaded entitlement blob.
+	 */
+
+	if (task != NULL && IOTaskHasEntitlement(task, "com.apple.developer.networking.topology-observation")) {
+		NETOBS_LOG("%s process has network observer entitlement, allowing access (proc=%s)\n", log_prefix, proc->p_comm);
+		return true;
+	}
+
+	/*
+	 * Signed third-party applications are allowed to observe the
+	 * network when they have a bundle identifier that does not belong
+	 * to Apple.  The validation category decides whether the
+	 * application is trusted enough to skip the parent chain walk.
+	 *
+	 * A missing identity, an empty identity, an identity without a dot
+	 * or an Apple identity are not third-party: those processes fall
+	 * through to the standard checks below.
+	 */
+	const char * bundle_id = cs_identity_get(proc);
+	bool first_party = (bundle_id != NULL &&
+	    bundle_id[0] != '\0' &&
+	    strchr(bundle_id, '.') != NULL &&
+	    !strprefix(bundle_id, "com.apple."));
+	if (first_party) {
+		/*
+		 * The binary is third party.  Query its validation
+		 * category; an unknown category is treated as unsigned.
+		 */
+
+
+		u_int32_t validation_category = (u_int32_t)-1;
+		bool category_valid = (csproc_get_validation_category(proc, &validation_category) == 0);
+
+		if (category_valid) {
+			if (validation_category == CS_VALIDATION_CATEGORY_DEVELOPER_ID) {
+				/* Developer ID signed binaries are allowed. */
+				NETOBS_LOG("%s Developer ID signed binary, allowing access (proc=%s, bundle_id=%s)\n", log_prefix, proc->p_comm, bundle_id);
+				return true;
+			}
+
+			/* Signed third-party binaries go through the standard checks. */
+			if (validation_category >= CS_VALIDATION_CATEGORY_TESTFLIGHT &&
+			    validation_category < CS_VALIDATION_CATEGORY_DEVELOPER_ID) {
+				NETOBS_LOG("%s third-party signed binary (proc=%s, bundle_id=%s, category=%d), applying standard checks\n", log_prefix, proc->p_comm, bundle_id, validation_category);
+			}
+		}
+
+		/*
+		 * Unsigned binaries are allowed when their parent chain is clean.
+		 */
+		if (validation_category < CS_VALIDATION_CATEGORY_TESTFLIGHT ||
+		    validation_category >= CS_VALIDATION_CATEGORY_DEVELOPER_ID) {
+			/*
+			 * The chain walk is asked to honor the observer
+			 * entitlement, so an entitled ancestor is enough to
+			 * allow the process even when the rest of the chain
+			 * is not platform signed.
+			 *
+			 * A clean chain means every ancestor was platform or
+			 * Developer ID signed (or the chain ended at launchd).
+			 */
+			parent_chain_info_t info = {};
+			parent_chain_result_t chain_result =
+			    check_parent_chain(proc, true, &info);
+
+			if (chain_result == PARENT_CHAIN_CLEAN) {
+				/* The chain is clean: allow the observation. */
+				NETOBS_LOG("%s unsigned third-party app (proc=%s, bundle_id=%s%s), allowing access (vc=%d)\n", log_prefix, proc->p_comm, bundle_id, info.entitled_ancestor ? ", via entitled ancestor" : "", validation_category);
+				return true;
+			} else {
+				/*
+				 * Not clean: apply the standard checks below.
+				 */
+				NETOBS_LOG("%s unsigned binary with non-clean parent chain (result=%d, untrusted=%s pid=%d), applying standard checks (proc=%s)\n", log_prefix, chain_result, info.untrusted_name, info.untrusted_pid, proc->p_comm);
+			}
+
+			/*
+			 * Fall through to the standard checks below.
+			 */
+		}
+	}
+
+	/*
+	 * Standard checks for every process that was not allowed above.
+	 * A platform binary is allowed when its parent chain is clean; a
+	 * non-platform binary is always denied.
+	 *
+	 * These checks apply to:
+	 *   - platform binaries with no entitlement,
+	 *   - third-party binaries with an invalid or unsigned category,
+	 *   - Apple binaries, which are not third-party.
+	 *
+	 * The observer entitlement is honored in the chain walk, so a
+	 * helper spawned by an entitled daemon is allowed here as well.
+	 */
+	if (task != NULL && task_get_platform_binary(task)) {
+		/*
+		 * The platform binary's parent chain must be clean.  The
+		 * chain walk honors the observer entitlement so a helper
+		 * spawned by an entitled daemon is allowed even though its
+		 * ancestors are not platform signed.
+		 *
+		 * A chain that reaches launchd without finding a
+		 * non-platform, non-Developer-ID ancestor is clean.
+		 *
+		 * The walk is bounded by MAX_PARENT_CHAIN_DEPTH, so a very
+		 * deep or cyclic hierarchy is reported as untrusted rather
+		 * than stalling the caller.
+		 */
+		parent_chain_info_t info = {};
+		parent_chain_result_t chain_result =
+		    check_parent_chain(proc, true, &info);
+
+		if (chain_result != PARENT_CHAIN_CLEAN) {
+			NETOBS_LOG("%s platform binary spawned by non-platform parent (result=%d, untrusted=%s pid=%d), denying access (proc=%s)\n", log_prefix, chain_result, info.untrusted_name, info.untrusted_pid, proc->p_comm);
+			return false;
+		}
+
+		/* The chain is clean: allow the observation. */
+
+		NETOBS_LOG("%s platform binary with clean parent chain%s, allowing access (proc=%s)\n", log_prefix, info.entitled_ancestor ? ", via entitled ancestor" : "", proc->p_comm);
+		return true;
+	}
+
+	/*
+	 * The process is not platform signed and did not qualify above:
+	 * deny the observation.
+	 *
+	 * This covers unsigned third-party applications whose parent
+	 * chain was not clean, Apple applications with a non-platform
+	 * signature, and any process without a usable code signature.
+	 *
+	 * The denial is deliberately silent outside development kernels:
+	 * NETOBS_LOG is empty in release builds, so a release kernel only
+	 * returns the boolean and the caller decides how to report it.
+	 *
+	 * This is the only exit that denies access without an explicit
+	 * validation failure: it is reached when none of the allow rules
+	 * applied.
+	 */
+	NETOBS_LOG("%s non-platform process, denying access (proc=%s)\n", log_prefix, proc->p_comm);
+	return false;
 }
 
