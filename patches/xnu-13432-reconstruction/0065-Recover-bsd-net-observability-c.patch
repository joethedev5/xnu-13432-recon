 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <sys/proc_private.h>
+#include <sys/socketvar.h>
+#include <sys/sysctl.h>
+#include <sys/ubc.h>
+#include <sys/codesign.h>
+#include <sys/lockdown_mode.h>
+#include <sys/vm.h>
