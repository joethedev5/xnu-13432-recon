+/*
+ * Network observability lets privileged processes inspect the sockets and
+ * connections of other processes.  The policy is deliberately
+ * conservative: a process is trusted only when every ancestor that could
+ * have influenced it is either platform signed or properly signed by a
+ * third-party certificate.  The walk never trusts the immediate parent
+ * alone, because a helper process can be re-parented into a trusted
+ * daemon.
+ *
+ * The result of the walk is one of the two values below.  The details of
+ * the first untrusted ancestor are filled into parent_chain_info_t so the
+ * caller can log them and so the policy can be diagnosed without
+ * inspecting the process hierarchy separately.
+ *
+ * The categories used when validating a signed third-party binary come
+ * from cs_blobs.h.  TestFlight, development, App Store and enterprise
+ * signed binaries are treated as signed; a Developer ID signature is
+ * trusted directly; everything else (ad-hoc or unsigned) is considered
+ * unsigned.
+ */
+typedef enum : uint32_t {
+	PARENT_CHAIN_CLEAN = 0,
+	PARENT_CHAIN_HAS_UNTRUSTED = 1,
+	/* A process in the chain could not be validated. */
+} parent_chain_result_t;
+
+/*
+ * Details about the first ancestor that made the chain untrusted.
+ *
+ * entitled_ancestor is set when the walk stopped at an ancestor that
+ * holds the network observer entitlement; in that case the chain is
+ * considered clean for the purposes of the policy, and the caller only
+ * uses the flag for diagnostics.
+ *
+ * untrusted_pid and untrusted_name describe the process that failed the
+ * validation.  untrusted_name is the process command name, not the
+ * executable path, and is truncated to the size of proc_name_t.  The
+ * structure is copied out by value at the end of the walk, so it must
+ * stay small; proc_name_t is MAXCOMLEN + 1 bytes and the padding is
+ * explicit in the layout below.
+ */
+typedef struct {
+	bool entitled_ancestor;
+	pid_t untrusted_pid;
+	proc_name_t untrusted_name;
+} parent_chain_info_t;
+
+#if DEVELOPMENT || DEBUG
+#define NETOBS_LOG(fmt, ...) \
+	do { \
+		if (net_network_observability_logging && net_observability_log) { \
+			os_log(net_observability_log, fmt, ##__VA_ARGS__); \
+		} \
+	} while (0)
+#else
+#define NETOBS_LOG(fmt, ...) do { } while (0)
+#endif
 
-#define RECON_BSD_NET_OBSERVABILITY_C 1
+/*
+ * The chain is bounded so a cycle in the parent pointers (or a very
+ * deep hierarchy) cannot stall the caller.  The limit is well above any
+ * hierarchy seen in practice.
+ */
+#define MAX_PARENT_CHAIN_DEPTH 63
 
-/* bsd/net/observability.c:102 */
-parent_chain_result_t
-check_parent_chain(struct proc * proc, _Bool honor_entitlement, parent_chain_info_t * out_info)
+static parent_chain_result_t
+check_parent_chain(struct proc * proc, bool honor_entitlement,
+    parent_chain_info_t * out_info)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: check_parent_chain");
+	parent_chain_result_t result;
+	int depth;
+	pid_t ppid = proc_ppid(proc);
+	uint64_t ppid_uniqueid = proc_uniqueid(proc);
+	parent_chain_info_t info = {};
+
+	/* Walk up the chain until an ancestor fails validation. */
+
+	for (depth = 0; ppid >= 2 && depth < MAX_PARENT_CHAIN_DEPTH; depth++) {
+		proc_t p = proc_find(ppid);
+		if (p == NULL) {
+			/* The parent exited between the pid lookup and proc_find(). */
+			info.untrusted_pid = ppid;
+			result = PARENT_CHAIN_HAS_UNTRUSTED;
+			goto done;
+		}
+
+		/*
+		 * Guard against pid reuse while the chain is being walked:
+		 * the process found for ppid must not be the process whose
+		 * parent we followed to get here.  If it is, the chain is
+		 * cyclic and cannot be trusted.
+		 *
+		 * The name is recorded for the log message only.
+		 */
+		if (proc_uniqueid(p) == ppid_uniqueid) {
+			info.untrusted_pid = ppid;
+			strbufcpy(info.untrusted_name, sizeof(info.untrusted_name), p->p_comm, sizeof(info.untrusted_name));
+			proc_rele(p);
+			result = PARENT_CHAIN_HAS_UNTRUSTED;
+			goto done;
+		}
+
+		task_t task = proc_task(p);
+
+		/* A process that has no task cannot vouch for anything. */
+		if (task != NULL) {
+			/*
+			 * Entitlement handling.
+			 *
+			 * The network observer entitlement is the primary
+			 * authorization for observing the network.  A process
+			 * that holds it is allowed to see the sockets and
+			 * connections of every other process, regardless of
+			 * how it was launched.
+			 *
+			 * The entitlement is checked on the ancestor's task,
+			 * not on the process that started the walk.  Tasks
+			 * carry the loaded entitlement blob; the BSD process
+			 * does not.  An ancestor that holds the entitlement
+			 * therefore vouches for its descendants.
+			 *
+			 * The caller decides whether the entitlement is
+			 * honored.  The lockdown-mode path passes false,
+			 * because in lockdown mode only platform binaries
+			 * with a clean chain are allowed, and an entitled
+			 * third-party binary must not be able to bypass that
+			 * restriction.
+			 *
+			 * An entitled ancestor ends the walk with a clean
+			 * result.  There is no need to look further up: the
+			 * entitlement is an explicit grant by the system, and
+			 * the processes above the entitled one are, by
+			 * construction, the processes that launched it.
+			 *
+			 * The entitled_ancestor flag is reported to the
+			 * caller so its log messages can mention the reason
+			 * for the decision.  It is not used by the policy
+			 * itself; a clean result is all the caller needs.
+			 *
+			 * End of entitlement notes.
+			 */
+			if (honor_entitlement &&
+			    IOTaskHasEntitlement(task, "com.apple.developer.networking.topology-observation")) {
+				/* The ancestor is entitled: the chain is clean. */
+				info.entitled_ancestor = true;
+				proc_rele(p);
+				result = PARENT_CHAIN_CLEAN;
+				goto done;
+			}
+
+			/*
+			 * Every non-entitled ancestor must be platform
+			 * signed.  A third-party ancestor is acceptable
+			 * only when it holds a Developer ID signature,
+			 * because such a binary has a verifiable identity
+			 * even though it is not part of the platform.
+			 *
+			 * A platform binary is trusted as-is and the walk
+			 * continues with its parent.
+			 *
+			 */
+			if (!task_get_platform_binary(task)) {
+				/* The category is fetched for the process, not the task,
+				 * because codesigning is tracked on the BSD process. */
+				u_int32_t vc = 0;
+				if (csproc_get_validation_category(p, &vc) != 0 ||
+				    vc != CS_VALIDATION_CATEGORY_DEVELOPER_ID) {
+					/*
+					 * The ancestor is neither platform
+					 * signed nor Developer ID signed.
+					 * Record it and stop the walk; the
+					 * caller will deny the observation.
+					 *
+					 * The name is recorded for the log.
+					 */
+					info.untrusted_pid = ppid;
+					strbufcpy(info.untrusted_name, sizeof(info.untrusted_name), p->p_comm, sizeof(info.untrusted_name));
+					proc_rele(p);
+					result = PARENT_CHAIN_HAS_UNTRUSTED;
+					goto done;
+				}
+			}
+		}
+
+		/*
+		 * Move to the next ancestor.  proc_uniqueid() must be read
+		 * before the reference is dropped.
+		 */
+		ppid_uniqueid = proc_uniqueid(p);
+		ppid = proc_ppid(p);
+		proc_rele(p);
+	}
+	result = (depth >= MAX_PARENT_CHAIN_DEPTH) ? PARENT_CHAIN_HAS_UNTRUSTED : PARENT_CHAIN_CLEAN;
+
+	/* The walk finished or stopped early. */
+
+done:
+	/* The caller only needs the details when the chain failed. */
+	*out_info = info;
+
+	return result;
+}
+
+#if DEVELOPMENT || DEBUG
+os_log_t net_observability_log;
+
+void
+observability_init(void)
+{
+	net_observability_log = os_log_create("com.apple.xnu.net.observability", "");
 }
+#endif /* DEVELOPMENT || DEBUG */
 
