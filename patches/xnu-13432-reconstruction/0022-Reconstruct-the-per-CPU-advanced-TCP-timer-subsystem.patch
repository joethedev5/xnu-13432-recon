+	new_te = tcp_timer_entry_alloc(tp, timer_type, soft_expires, timeout_ns);
+	if (new_te == NULL) {
+		return ENOMEM;
+	}
+	cpu = tcp_timer_select_cpu(tp);
+	new_te->te_cpu = cpu;
+	per_cpu = &tcp_timer_cpus[new_te->te_cpu];
+
+	lck_mtx_lock(&per_cpu->cpu_lock);
+	tp->t_timer_entries[timer_type] = new_te;
+	RB_INSERT(tcp_timer_tree, &per_cpu->active_timers_tree, new_te);
+	per_cpu->active_timers_cnt++;
+	if (!(tp->t_flags & TF_TIMER_ENTRY_USECOUNT)) {
+		tp->t_flags |= TF_TIMER_ENTRY_USECOUNT;
+		tp->t_inpcb->inp_socket->so_usecount++;
+	}
+	if (new_te->te_expires < per_cpu->next_timer) {
+		per_cpu->next_timer = new_te->te_expires;
+		tcp_timer_reschedule_cpu(per_cpu);
+	}
+	lck_mtx_unlock(&per_cpu->cpu_lock);
+
+	return 0;
 }
 
