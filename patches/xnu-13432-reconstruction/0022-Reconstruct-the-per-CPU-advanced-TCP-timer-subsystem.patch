+/*
+ * Compute the soft expiry for a timer.  The leeway depends on the timer:
+ * retransmit-style timers use no leeway, keepalive/2MSL use 3.75% of the
+ * timeout, and the rest use 10%.  The leeway is capped at 100ms and the
+ * returned value never underflows.
+ */
 /* bsd/netinet/tcp_timer_advanced.c:99 */
 uint64_t
 tcp_timer_calculate_softexpires(uint8_t timer_type, uint64_t hard_expires, uint64_t timeout_ns)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_timer_calculate_softexpires");
+	uint64_t leeway;
+
+	if (timer_type <= 7) {
+		if ((1u << timer_type) & 0x1d) {
+			leeway = 0;
+		} else if ((1u << timer_type) & 0xc0) {
+			leeway = timeout_ns * 15 / 4 / 100;
+		} else {
+			leeway = timeout_ns / 10;
+		}
+	} else {
+		leeway = timeout_ns / 10;
+	}
+
+	leeway = MIN(leeway, 100 * NSEC_PER_MSEC);
+
+	if (hard_expires > leeway) {
+		return hard_expires - leeway;
+	}
+	return hard_expires;
 }
 
