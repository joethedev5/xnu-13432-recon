 /* bsd/netinet/tcp_timer_advanced.c:281 */
 int
 tcp_timer_advanced_add(struct tcpcb * tp, uint8_t timer_type, uint64_t timeout_ns)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_timer_advanced_add");
+	struct tcp_timer_cpu *per_cpu;
+	struct tcp_timer_entry *te;
+	struct tcp_timer_entry *new_te;
+	uint64_t soft_expires;
+	uint64_t now;
+	int cpu;
+
+	if (timer_type >= TCPT_NTIMERS) {
+		return EINVAL;
+	}
+
+	socket_lock_assert_owned(tp->t_inpcb->inp_socket);
+
+	now = tcp_timer_get_time();
+
+	/*
+	 * PTO and retransmit timers may need to be anchored to the last
+	 * transmit time instead of the current time, so that timers armed
+	 * by data transmission do not slide forward.
+	 */
+	if (timer_type == TCPT_PTO || timer_type == TCPT_REXMT) {
+		if ((int32_t)(tp->t_latest_tx - tcp_now) >= 1) {
+			uint64_t latest = tp->t_latest_tx_ns;
+
+			if (latest != 0 &&
+			    latest >= now - NSEC_PER_SEC &&
+			    latest <= now + 60 * NSEC_PER_SEC) {
+				now = latest;
+			}
+		}
+	}
+
+	soft_expires = now + timeout_ns;
+
+	te = tp->t_timer_entries[timer_type];
+	if (te != NULL) {
+		cpu = te->te_cpu;
+		per_cpu = &tcp_timer_cpus[cpu];
+
+		lck_mtx_lock(&per_cpu->cpu_lock);
+		if (te->te_flags & TE_FLAG_EXECUTING) {
+			/*
+			 * The timer is being run by the timer thread; detach
+			 * it and allocate a fresh entry instead.
+			 */
+			te->te_tp = NULL;
+			tp->t_timer_entries[timer_type] = NULL;
+			lck_mtx_unlock(&per_cpu->cpu_lock);
+			goto new_entry;
+		}
+		if (te->te_flags & TE_FLAG_IN_TREE) {
+			tcp_timer_tree_remove(per_cpu, te);
+		}
+		te->te_type = timer_type;
+		te->te_expires = soft_expires;
+		te->te_softexpires = tcp_timer_calculate_softexpires(timer_type,
+		    soft_expires, timeout_ns);
+		te->te_flags = TE_FLAG_IN_TREE;
+		RB_INSERT(tcp_timer_tree, &per_cpu->active_timers_tree, te);
+		per_cpu->active_timers_cnt++;
+		if (per_cpu->active_timers_tree.rbh_root != NULL) {
+			struct tcp_timer_entry *min;
+
+			min = RB_MIN(tcp_timer_tree, &per_cpu->active_timers_tree);
+			if (min->te_expires != per_cpu->next_timer) {
+				per_cpu->next_timer = min->te_expires;
+				tcp_timer_reschedule_cpu(per_cpu);
+			}
+		}
+		lck_mtx_unlock(&per_cpu->cpu_lock);
+		return 0;
+	}
+
