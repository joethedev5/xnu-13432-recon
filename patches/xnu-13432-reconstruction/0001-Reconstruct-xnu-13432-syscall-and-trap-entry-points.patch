+/*
+ * The pipe2 system call: pipe() with flags.
+ *
+ * Currently supported flags are O_CLOEXEC, O_CLOFORK and O_NONBLOCK.
+ */
+/* ARGSUSED */
+int
+pipe2(proc_t p, struct pipe2_args *uap, int32_t *retval)
+{
+	struct fileproc *rf = NULL, *wf = NULL;
+	struct pipe *rpipe, *wpipe;
+	int error;
+	fileproc_flags_t oflags = 0;
+
+	if (uap->flags & ~(O_CLOEXEC | O_CLOFORK | O_NONBLOCK)) {
+		return EINVAL;
+	}
+
+	error = pipepair_alloc(&rpipe, &wpipe);
+	if (error) {
+		return error;
+	}
+
+	/*
+	 * for now we'll create half-duplex pipes(refer returns section above).
+	 * this is what we've always supported..
+	 */
+
+	error = falloc(p, &rf, &retval[0]);
+	if (error) {
+		goto freepipes;
+	}
+	rf->f_flag = FREAD;
+	rf->f_ops = &pipeops;
+	fp_set_data(rf, rpipe);
+
+	error = falloc(p, &wf, &retval[1]);
+	if (error) {
+		fp_free(p, retval[0], rf);
+		goto freepipes;
+	}
+	wf->f_flag = FWRITE;
+	wf->f_ops = &pipeops;
+	fp_set_data(wf, wpipe);
+
+	if (uap->flags & O_CLOEXEC) {
+		oflags |= FP_CLOEXEC;
+	}
+	if (uap->flags & O_CLOFORK) {
+		oflags |= FP_CLOFORK;
+	}
+	rf->fp_flags |= oflags;
+	wf->fp_flags |= oflags;
+
+	if (uap->flags & O_NONBLOCK) {
+		rf->f_flag |= FNONBLOCK;
+		wf->f_flag |= FNONBLOCK;
+	}
+
+	rpipe->pipe_peer = wpipe;
+	wpipe->pipe_peer = rpipe;
+
+#if CONFIG_MACF
+	/*
+	 * XXXXXXXX SHOULD NOT HOLD FILE_LOCK() XXXXXXXXXXXX
+	 *
+	 * struct pipe represents a pipe endpoint.  The MAC label is shared
+	 * between the connected endpoints.  As a result mac_pipe_label_init() and
+	 * mac_pipe_label_associate() should only be called on one of the endpoints
+	 * after they have been connected.
+	 */
+	mac_pipe_label_init(rpipe);
+	mac_pipe_label_associate(kauth_cred_get(), rpipe);
+#endif
+	proc_fdlock_spin(p);
+	procfdtbl_releasefd(p, retval[0], NULL);
+	procfdtbl_releasefd(p, retval[1], NULL);
+	fp_drop(p, retval[0], rf, 1);
+	fp_drop(p, retval[1], wf, 1);
+	proc_fdunlock(p);
+	return 0;
+
+freepipes:
+	pipeclose(rpipe);
+	pipeclose(wpipe);
+	return error;
+}
