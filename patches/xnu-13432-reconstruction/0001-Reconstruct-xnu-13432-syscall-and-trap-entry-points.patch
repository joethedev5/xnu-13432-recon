+
+/*
+ * arm64 user exception handling (uexc).
+ *
+ * A process may register a user-space handler for a text range; data aborts
+ * that fall inside that range are redirected to the handler instead of
+ * being turned into Mach exceptions.  The handler is entered with a new
+ * stack pointer and a frame describing the fault.
+ */
+
+typedef struct {
+	uint64_t pc;
+	uint64_t sp;
+	uint64_t esr;
+	uint64_t far;
+	uint64_t refcon;
+} arm64_uexc_frame_t;
+
+#define ARM64_UEXC_STACK_RESERVE 0xb0
+#define ARM64_UEXC_USER_ADDR_MAX 0x7ffffe000000ULL
+
+bool
+configure_uexc_handler(user_addr_t start, user_size_t size,
+    user_addr_t handler, user_addr_t refcon)
+{
+	arm64_uexc_region_t region = { 0 };
+	thread_t thread = current_thread();
+	task_t task = get_threadtask(thread);
+	user_addr_t end;
+
+	/* The region must not overflow and must stay in user space. */
+	if (os_add_overflow(start, size, &end)) {
+		return false;
+	}
+	if (end > ARM64_UEXC_USER_ADDR_MAX) {
+		return false;
+	}
+	if (handler == 0 || handler > ARM64_UEXC_USER_ADDR_MAX) {
+		return false;
+	}
+
+	region.start = start;
+	region.end = end;
+	region.handler = (void *)handler;
+	region.refcon = refcon;
+
+	task->uexc = region;
+	return true;
+}
+
+void
+handle_uexc_fault(arm_saved_state_t *ss, arm64_uexc_region_t *region,
+    uint64_t esr, vm_offset_t far)
+{
+	arm64_uexc_frame_t frame = { 0 };
+	void *handler = region->handler;
+	user_addr_t sp;
+
+	if (handler == NULL) {
+		return;
+	}
+
+	frame.pc = (uint64_t)get_saved_state_pc(ss);
+	frame.sp = (uint64_t)get_saved_state_sp(ss);
+	frame.esr = esr;
+	frame.far = far;
+	frame.refcon = region->refcon;
+
+	sp = (user_addr_t)(frame.sp - ARM64_UEXC_STACK_RESERVE);
+	set_saved_state_sp(ss, (register_t)sp);
+	set_saved_state_pc(ss, (register_t)(uintptr_t)handler);
+
+	(void)copyout(&frame, sp, sizeof(frame));
+}
diff --git a/osfmk/arm64/x86_64_compat.c b/osfmk/arm64/x86_64_compat.c
index d75169a06..62eea80ea 100644
--- a/osfmk/arm64/x86_64_compat.c
+++ b/osfmk/arm64/x86_64_compat.c
@@ -40,9 +40,32 @@
 
 
 bool
-ml_satisfies_x86_64_requirements(ml_entitlement_check __unused check_ent)
+ml_satisfies_x86_64_requirements(ml_entitlement_check check_ent)
 {
-	/* Not supported. This cannot be a static inline function, because it's exported. */
-	return false;
+	/* This cannot be a static inline function, because it's exported. */
+	if (check_ent("com.apple.developer.cross-architecture-support")) {
+		return true;
+	}
+	return check_ent("com.apple.developer.cross-architecture-support-unmanaged");
+}
+
+kern_return_t
+thread_set_x86_64_compat_trap(struct thread_set_x86_64_compat_trap_args *args)
+{
+	thread_t t = current_thread();
+	task_t task = get_threadtask(t);
+	uint32_t enable;
+
+	if (!task->x86_64_compat_entitled) {
+		return KERN_FAILURE;
+	}
+
+	enable = args->enable;
+	if (enable > 1) {
+		return KERN_INVALID_ARGUMENT;
+	}
+
+	t->machine.x86_64_compat = enable;
+	return KERN_SUCCESS;
 }
 
