+/*
+ * fd_expand_descr_table_locked
+ *
+ * Description:	Expand the file descriptor table so that file descriptor
+ *		`upto` can be addressed.  The caller must hold proc_fdlock();
+ *		this routine returns with proc_fdlock() held.
+ *
+ * Parameters:	p				Process whose table to grow
+ *		upto				Descriptor that must become valid
+ *		lim				Current descriptor limit
+ *
+ * Returns:	0				Success (table grown or already large enough)
+ *		EBADF				`upto` overflows the table size computation
+ *		EMFILE				The hard limit does not permit growth
+ *		ENOMEM				Allocation failure
+ */
+static int
+fd_expand_descr_table_locked(proc_t p, int upto, int lim)
+{
+	struct filedesc *fdp = &p->p_fd;
+	int numfiles, num_files_to_clean;
+	struct fileproc **newofiles = NULL, **files_to_clean = NULL;
+	char *newofileflags = NULL, *filesflags_to_clean = NULL;
+	int result = 0;
+	int upto_overflow_check;
+
+	if (fdp->fd_nfiles > upto) {
+		return 0;
+	}
+
+	result = MAX(upto, NDEXTENT);
+	if (os_add_overflow(result, 1, &upto_overflow_check)) {
+		return EBADF;
+	}
+	numfiles = (int)MIN((uint64_t)lim, bit_ceiling((uint64_t)result + 1));
+	if (result >= numfiles) {
+		return EMFILE;
+	}
+
+	proc_fdunlock(p);
+	newofiles = kalloc_type(struct fileproc *, numfiles, Z_WAITOK | Z_ZERO);
+	newofileflags = kalloc_data(numfiles, Z_WAITOK | Z_ZERO);
+	proc_fdlock(p);
+
+	if (newofiles == NULL || newofileflags == NULL) {
+		result = ENOMEM;
+		files_to_clean = newofiles;
+		filesflags_to_clean = newofileflags;
+		num_files_to_clean = numfiles;
+		goto out;
+	}
+	if (fdp->fd_nfiles >= numfiles) {
+		result = 0;
+		files_to_clean = newofiles;
+		filesflags_to_clean = newofileflags;
+		num_files_to_clean = numfiles;
+		goto out;
+	}
+
+	num_files_to_clean = fdp->fd_nfiles;
+	memcpy(newofiles, fdp->fd_ofiles,
+	    num_files_to_clean * sizeof(*fdp->fd_ofiles));
+	memcpy(newofileflags, fdp->fd_ofileflags, num_files_to_clean);
+	files_to_clean = fdp->fd_ofiles;
+	filesflags_to_clean = fdp->fd_ofileflags;
+	fdp->fd_ofiles = newofiles;
+	fdp->fd_ofileflags = newofileflags;
+	fdp->fd_nfiles = numfiles;
+
+out:
+	proc_fdunlock(p);
+	kfree_type(struct fileproc *, num_files_to_clean, files_to_clean);
+	kfree_data(filesflags_to_clean, num_files_to_clean);
+	proc_fdlock(p);
+	return result;
+}
