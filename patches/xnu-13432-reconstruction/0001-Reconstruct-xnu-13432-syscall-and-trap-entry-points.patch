+extern bool configure_uexc_handler(user_addr_t start, user_size_t size,
+    user_addr_t handler, user_addr_t refcon);
+
+int
+register_uexc_handler(proc_t p, struct register_uexc_handler_args *uap,
+    __unused int32_t *retval)
+{
+	int uexc_enable = 0;
+	task_t task;
+
+	PE_parse_boot_argn("-enable_uexc", &uexc_enable, sizeof(uexc_enable));
+	if (!uexc_enable) {
+		return EPERM;
+	}
+
+	task = get_threadtask(current_thread());
+	if (task == kernel_task) {
+		return EPERM;
+	}
+	if (get_bsdtask_info(task) == NULL) {
+		return EPERM;
+	}
+	if (!IOTaskHasEntitlement(task, "com.apple.private.uexc")) {
+		return EPERM;
+	}
+	if (!configure_uexc_handler(uap->start, uap->size, uap->handler,
+	    uap->refcon)) {
+		return EINVAL;
+	}
+	return 0;
+}
