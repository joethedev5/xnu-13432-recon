+/*
+ * sys_dup3
+ *
+ * Description:	Duplicate a file descriptor to a particular value, with
+ *		O_CLOEXEC/O_CLOFORK semantics.
+ */
 int
+sys_dup3(proc_t p, struct dup3_args *uap, int32_t *retval)
+{
+	fileproc_flags_t fp_flags = 0;
+
+	if (uap->from == uap->to) {
+		return EINVAL;
+	}
+	if (uap->flags & ~(O_CLOEXEC | O_CLOFORK)) {
+		return EINVAL;
+	}
+	if (uap->flags & O_CLOEXEC) {
+		fp_flags |= FP_CLOEXEC;
+	}
+	if (uap->flags & O_CLOFORK) {
+		fp_flags |= FP_CLOFORK;
+	}
+	return dup_internal(p, current_cached_proc_cred(p), uap->from, uap->to,
+	           fp_flags, retval);
+}
+
+static inline int
 dup2(proc_t p, kauth_cred_t p_cred, int old, int new, int *retval)
+{
+	return dup_internal(p, p_cred, old, new, 0, retval);
+}
+
+/*
+ * close_fp_for_dup
+ *
+ * Description:	Close the file proc currently occupying `newfd` in
+ *		preparation for a dup.  The caller holds proc_fdlock();
+ *		this routine drops it and returns with it reacquired.
+ *
+ * Returns:	0			Success
+ *		EPERM			The target is guarded against close
+ */
+static int
+close_fp_for_dup(proc_t p, int newfd, struct fileproc *nfp,
+    kauth_cred_t p_cred)
+{
+	if (fp_isguarded(nfp, GUARD_CLOSE)) {
+		return fp_guard_exception(p, newfd, nfp, kGUARD_EXC_CLOSE);
+	}
+	(void)fp_close_and_unlock_with_action(p, p_cred, newfd, nfp,
+	    FD_DUP2RESV);
+	proc_fdlock(p);
+	return 0;
+}
+
+/*
+ * dup_internal
+ *
+ * Description:	Common code for dup, dup2, dup3 and fcntl(F_DUPFD).
+ *
+ * Parameters:	p				Process performing the dup
+ *		p_cred				Credentials to use
+ *		old				The fd to dup
