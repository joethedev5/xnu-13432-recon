From 81230cc9147acd5dfbca59192ff6f3608b4be01a Mon Sep 17 00:00:00 2001
From: joethedev5 <deepsbx1@proton.me>
Date: Wed, 25 Nov 2026 02:26:33 +0000
Subject: [PATCH 08/45] Reconstruct RBBR state management and register the
 algorithm

DWARF variable locations identify the real RBBR globals:
tcp_rbbr_state_zone, rbbr_rtt_probe_rwnd_mss (10) and
rbbr_rtt_probe_period (30), plus the tcp_cc_rbbr algorithm record.

- tcp_rbbr_init: allocate the per-connection state from the kalloc-type
  zone, bump tcp_cc_rbbr.num_sockets, initialize the window from
  rbbr_rtt_probe_rwnd_mss, and schedule the next RTT probe boundary.
- tcp_rbbr_switch_to: same body as the reference (the compiler folded
  the two identical functions).
- tcp_rbbr_cleanup: drop the socket count and free the state.
- Declare tcp_cc_rbbr in tcp_cc.h and replace the provisional parameter
  names in the earlier rwnd/after-idle bodies with the recovered ones.

Remaining explicit stubs: 302.

Authored-By: joethedev5 <joeshmo@nunya.com>
---
 bsd/netinet/tcp_cc.h   |  1 +
 bsd/netinet/tcp_rbbr.c | 96 ++++++++++++++++++++++++++++++++++++------
 2 files changed, 83 insertions(+), 14 deletions(-)

diff --git a/bsd/netinet/tcp_cc.h b/bsd/netinet/tcp_cc.h
index 042933685..58eadf94c 100644
--- a/bsd/netinet/tcp_cc.h
+++ b/bsd/netinet/tcp_cc.h
@@ -269,6 +269,7 @@ struct tcp_rcv_cc_algo {
 } __attribute__((aligned(4)));
 
 extern struct tcp_rcv_cc_algo tcp_cc_rledbat;
+extern struct tcp_rcv_cc_algo tcp_cc_rbbr;
 
 extern void tcp_cc_init(void);
 extern void tcp_cc_resize_sndbuf(struct tcpcb *tp);
diff --git a/bsd/netinet/tcp_rbbr.c b/bsd/netinet/tcp_rbbr.c
index 0a23f8fe6..c095568c1 100644
--- a/bsd/netinet/tcp_rbbr.c
+++ b/bsd/netinet/tcp_rbbr.c
@@ -10,15 +10,38 @@
 #include <sys/systm.h>
 #include <sys/kernel.h>
 #include <netinet/tcp_rbbr.h>
+#include <netinet/tcp_var.h>
+#include <netinet/tcp_cc.h>
+#include <kern/kalloc.h>
+#include <os/atomic_private.h>
 
 #define RECON_BSD_NETINET_TCP_RBBR_C 1
 
-/*
- * Values read from the reference image at 0xfffffe0007cbf450 and
- * 0xfffffe0007cbf44c; kept as globals so the generated code loads them.
- */
-uint32_t tcp_rbbr_rwnd_init_mss = 10;
-uint32_t tcp_rbbr_probe_rtt_secs = 30;
+void tcp_rbbr_init(struct tcpcb *tp);
+void tcp_rbbr_cleanup(struct tcpcb *tp);
+void tcp_rbbr_rwnd_init(struct tcpcb *tp);
+void tcp_rbbr_data_rcvd(struct tcpcb *tp, struct tcphdr *th,
+    struct tcpopt *to, uint32_t segment_len);
+uint32_t tcp_rbbr_get_rlwin(struct tcpcb *tp);
+void tcp_rbbr_after_idle(struct tcpcb *tp);
+void tcp_rbbr_switch_to(struct tcpcb *tp);
+
+KALLOC_TYPE_DEFINE(tcp_rbbr_state_zone, struct tcp_rbbr_state, NET_KT_DEFAULT);
+
+/* Sysctl-tunable RBBR parameters; values from the reference image. */
+uint32_t rbbr_rtt_probe_rwnd_mss = 10;   /* 0xfffffe0007cbf450 */
+uint32_t rbbr_rtt_probe_period = 30;     /* 0xfffffe0007cbf44c */
+
+struct tcp_rcv_cc_algo tcp_cc_rbbr = {
+	.name = "rbbr",
+	.init = tcp_rbbr_init,
+	.cleanup = tcp_rbbr_cleanup,
+	.rwnd_init = tcp_rbbr_rwnd_init,
+	.data_rcvd = tcp_rbbr_data_rcvd,
+	.get_rlwin = tcp_rbbr_get_rlwin,
+	.after_idle = tcp_rbbr_after_idle,
+	.switch_to = tcp_rbbr_switch_to,
+};
 
 /* bsd/netinet/tcp_rbbr.c:245 */
 uint32_t
@@ -280,16 +303,40 @@ rbbr_update_phase(struct tcpcb * tp, uint32_t now)
 void
 tcp_rbbr_init(struct tcpcb * tp)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_rbbr_init");
+	struct tcp_rbbr_state *rbbr;
+	uint32_t now = tcp_now;
+	uint32_t interval;
+
+	if (tp->t_rbbr_state != NULL) {
+		return;
+	}
+	rbbr = zalloc_flags(tcp_rbbr_state_zone, Z_ZERO);
+	tp->t_rbbr_state = rbbr;
+	os_atomic_inc(&tcp_cc_rbbr.num_sockets, relaxed);
+
+	memset(rbbr, 0, sizeof(*rbbr));
+	rbbr->rwnd_est = tp->t_maxseg * rbbr_rtt_probe_rwnd_mss;
+	rbbr->win = (rbbr->rwnd_est + (tp->t_maxseg >> 1)) /
+	    tp->t_maxseg * tp->t_maxseg;
+	if (rbbr->win > (0xffffu << tp->rcv_scale)) {
+		rbbr->win = 0xffffu << tp->rcv_scale;
+	}
+	rbbr->win_change_pending = 1;
+	rbbr->phase = 0;
+	rbbr->phase_start_ts = now;
+	interval = (rbbr_rtt_probe_period > 1 ? rbbr_rtt_probe_period : 1) * 1000;
+	rbbr->next_probe_rtt_ts = (now / interval + 1) * interval;
 }
 
 /* bsd/netinet/tcp_rbbr.c:1553 */
 void
 tcp_rbbr_cleanup(struct tcpcb * tp)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_rbbr_cleanup");
+	if (tp->t_rbbr_state != NULL) {
+		os_atomic_dec(&tcp_cc_rbbr.num_sockets, relaxed);
+		zfree(tcp_rbbr_state_zone, tp->t_rbbr_state);
+		tp->t_rbbr_state = NULL;
+	}
 }
 
 /* bsd/netinet/tcp_rbbr.c:1563 */
@@ -384,7 +431,7 @@ tcp_rbbr_after_idle(struct tcpcb * tp)
 	} else {
 		uint32_t max_win;
 
-		saved_est = tp->t_maxseg * tcp_rbbr_rwnd_init_mss;
+		saved_est = tp->t_maxseg * rbbr_rtt_probe_rwnd_mss;
 		rbbr->rwnd_est = saved_est;
 		saved_est = (saved_est + (tp->t_maxseg >> 1)) /
 		    tp->t_maxseg * tp->t_maxseg;
@@ -395,7 +442,7 @@ tcp_rbbr_after_idle(struct tcpcb * tp)
 
 	rbbr->phase = 0;
 	rbbr->phase_start_ts = now;
-	interval = (tcp_rbbr_probe_rtt_secs > 1 ? tcp_rbbr_probe_rtt_secs : 1) * 1000;
+	interval = (rbbr_rtt_probe_period > 1 ? rbbr_rtt_probe_period : 1) * 1000;
 	rbbr->next_probe_rtt_ts = (now / interval + 1) * interval;
 }
 
@@ -403,6 +450,27 @@ tcp_rbbr_after_idle(struct tcpcb * tp)
 void
 tcp_rbbr_switch_to(struct tcpcb * tp)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_rbbr_switch_to");
+	struct tcp_rbbr_state *rbbr;
+	uint32_t now = tcp_now;
+	uint32_t interval;
+
+	if (tp->t_rbbr_state != NULL) {
+		return;
+	}
+	rbbr = zalloc_flags(tcp_rbbr_state_zone, Z_ZERO);
+	tp->t_rbbr_state = rbbr;
+	os_atomic_inc(&tcp_cc_rbbr.num_sockets, relaxed);
+
+	memset(rbbr, 0, sizeof(*rbbr));
+	rbbr->rwnd_est = tp->t_maxseg * rbbr_rtt_probe_rwnd_mss;
+	rbbr->win = (rbbr->rwnd_est + (tp->t_maxseg >> 1)) /
+	    tp->t_maxseg * tp->t_maxseg;
+	if (rbbr->win > (0xffffu << tp->rcv_scale)) {
+		rbbr->win = 0xffffu << tp->rcv_scale;
+	}
+	rbbr->win_change_pending = 1;
+	rbbr->phase = 0;
+	rbbr->phase_start_ts = now;
+	interval = (rbbr_rtt_probe_period > 1 ? rbbr_rtt_probe_period : 1) * 1000;
+	rbbr->next_probe_rtt_ts = (now / interval + 1) * interval;
 }
