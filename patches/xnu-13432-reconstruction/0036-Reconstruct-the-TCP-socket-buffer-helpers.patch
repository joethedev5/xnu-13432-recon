 }
 
 /* bsd/netinet/tcp_sb.c:128 */
-static void
+void
 tcp_sbrcv_grow(struct tcpcb *tp, struct sockbuf *sbrcv,
     struct tcpopt *to, uint32_t pktlen)
 {
@@ -173,15 +187,31 @@ out:
 }
 
 /* bsd/netinet/tcp_sb.c:265 */
-void
-tcp_sbrcv_min_rwin(struct tcpcb * tp, struct sockbuf * sb)
+static void
+tcp_sbrcv_min_rwin(struct tcpcb *tp, struct sockbuf *sb)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_sbrcv_min_rwin");
+	u_int32_t rcvbufinc = tp->t_maxseg << 4;
+	u_int32_t rcvbuf = sb->sb_hiwat;
+	struct socket *so = tp->t_inpcb->inp_socket;
+
+	if (tcp_recv_bg == 1 || IS_TCP_RECV_BG(so)) {
+		return;
+	}
+
+	if (tcp_do_autorcvbuf == 1 &&
+	    (tp->t_flags & TF_SLOWLINK) == 0 &&
+	    (so->so_flags1 & SOF1_EXTEND_BK_IDLE_WANTED) == 0 &&
+	    (rcvbuf - sb->sb_cc) < rcvbufinc &&
+	    rcvbuf < tcp_autorcvbuf_max &&
+	    (sb->sb_idealsize > 0 &&
+	    sb->sb_hiwat <= (sb->sb_idealsize + rcvbufinc))) {
+		sbreserve(sb,
+		    min((sb->sb_hiwat + rcvbufinc), tcp_autorcvbuf_max));
+	}
 }
 
