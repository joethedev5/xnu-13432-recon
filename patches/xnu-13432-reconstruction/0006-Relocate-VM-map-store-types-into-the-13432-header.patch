-#define VMN_PACKED_PTR_BITS         32
-#define VMN_PACKED_PTR_SHIFT        8
-#define VMN_PACKED_PTR_BASE         ((uintptr_t)VM_MIN_KERNEL_AND_KEXT_ADDRESS)
