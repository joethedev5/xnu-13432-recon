+/*
+ * Probe the dedupe table for hash.  The probe sequence walks forward
+ * from the hash until it finds the hash itself, an empty slot, or the
+ * probe limit.
+ */
 /* osfmk/vm/vm_page_telemetry.c:186 */
-_Bool
+static inline bool
 vmpt_is_duplicate(uint32_t hash)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: vmpt_is_duplicate");
+	size_t idx;
+
+	for (size_t i = 0, probe = hash; i < VMPT_DEDUPE_PROBES; i++, probe++) {
+		idx = probe & (VMPT_DEDUPE_SIZE - 1);
+
+		uint32_t existing = vmpt_dedupe_table[idx];
+
+		if (existing == hash) {
+			return true;
+		}
+		if (existing == 0) {
+			return false;
+		}
+	}
+
+	return false;
 }
 
+/*
