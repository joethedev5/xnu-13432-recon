+/*
+ * Convert one ring entry into a CoreAnalytics event and send it.
+ *
+ * The captured frames are rendered into the backtrace string; the kexts
+ * that contain them are looked up and their identifiers joined into the
+ * kext_ids string.  The lookups are only valid while the loaded kext
+ * summaries are the ones that were current when the frame addresses were
+ * captured, which the entry's kext_timestamp records.
+ */
 /* osfmk/vm/vm_page_telemetry.c:267 */
-void
+static inline void
 vmpt_send_ca_event(vmpt_ring_entry_t * entry)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: vmpt_send_ca_event");
+	ca_event_t ca_event = vmpt_alloc_ca_event(entry->code);
+
+	if (ca_event == NULL) {
+		return;
+	}
+
+	CA_EVENT_TYPE(vm_page_event) * event = ca_event->data;
+
+	telemetry_backtrace_to_string(event->backtrace, sizeof(event->backtrace),
+	    entry->frame_count, entry->frames);
+
+	if (entry->kext_timestamp == gLoadedKextSummariesTimestamp) {
+		unsigned int seen_count = 0;
+		uint32_t seen_tags[VMPT_MAX_KEXTS] = {};
+
+		for (unsigned int i = 0; i < entry->frame_count && seen_count < VMPT_MAX_KEXTS;
+		    i++) {
+			OSKextLoadedKextSummary summary = {};
+
+			if (OSKextGetLoadedKextSummaryForAddress((const void *)entry->frames[i],
+			    &summary) != KERN_SUCCESS) {
+				continue;
+			}
+
+			bool already_seen = false;
+
+			for (unsigned int j = 0; j < seen_count; j++) {
+				if (seen_tags[j] == summary.loadTag) {
+					already_seen = true;
+					break;
+				}
+			}
+
+			if (already_seen) {
+				continue;
+			}
+
+			seen_tags[seen_count] = summary.loadTag;
+			seen_count++;
+
+			char * ids = event->kext_ids;
+			size_t max_sz = sizeof(event->kext_ids);
+
+			if (ids[0] != '\0') {
+				strlcat(ids, ",", max_sz);
+			}
+			strlcat(ids, summary.name, max_sz);
+			if (strlen(ids) >= max_sz - 1) {
+				break;
+			}
+		}
+	}
+
+	event->code = entry->code;
+	event->subcode = entry->subcode;
+
+	core_analytics_send_event(ca_event);
 }
 
+/*
+ * Drain thread callback.  The ring is drained in batches: the batch size
+ * and starting index are taken under the lock, the lock is dropped while
+ * the events are formatted and sent, then the read index and remaining
+ * count are advanced under the lock.  New events that arrived meanwhile
+ * are picked up by the next iteration.
+ */
 /* osfmk/vm/vm_page_telemetry.c:334 */
-void
+static void
 vmpt_drain_thread(thread_call_param_t p0, thread_call_param_t p1)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: vmpt_drain_thread");
+	size_t drain_count;
+	size_t drain_rd;
+
+	lck_spin_lock(&vmpt_lock);
+
+	while ((drain_count = vmpt_ring_count) != 0) {
+		drain_rd = vmpt_ring_rd;
+		lck_spin_unlock(&vmpt_lock);
+
+		for (size_t i = 0; i < drain_count; i++) {
+			const size_t idx = (drain_rd + i) % VMPT_RING_SIZE;
+			vmpt_ring_entry_t * entry = &vmpt_ring[idx];
+
+			vmpt_send_ca_event(entry);
+		}
+
+		lck_spin_lock(&vmpt_lock);
+		vmpt_ring_rd = (vmpt_ring_rd + drain_count) % VMPT_RING_SIZE;
+		vmpt_ring_count -= drain_count;
+	}
+
+	lck_spin_unlock(&vmpt_lock);
 }
 
