+
+	if (vmpt_drain_thread_call == NULL) {
+#line 373 "vm_page_telemetry.c"
+		panic("vm_page_telemetry: failed to allocate drain thread");
+#line 348 "osfmk/vm/vm_page_telemetry.c"
+	}
 }
 
+/*
+ * Append an entry to the ring.  Returns false when the ring is full or,
+ * for the VMPT_DISABLED event, when it has already been reported.  The
+ * drain thread call is only entered once the thread call subsystem is
+ * initialized.
+ */
 /* osfmk/vm/vm_page_telemetry.c:383 */
-_Bool
+static bool
 vmpt_enqueue(vmpt_ring_entry_t * entry)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: vmpt_enqueue");
+	lck_spin_lock(&vmpt_lock);
+
+	if (vmpt_ring_count == VMPT_RING_SIZE) {
+		lck_spin_unlock(&vmpt_lock);
+
+		return false;
+	}
+
+	if (entry->code == VMPT_DISABLED) {
+		if (os_atomic_load(&vmpt_disable_reported, relaxed)) {
+			lck_spin_unlock(&vmpt_lock);
+			return false;
+		}
+		os_atomic_store(&vmpt_disable_reported, true, relaxed);
+	}
+
+	memmove(&vmpt_ring[vmpt_ring_wr], entry, sizeof(*entry));
+	vmpt_ring_wr = (vmpt_ring_wr + 1) % VMPT_RING_SIZE;
+	vmpt_ring_count++;
+
+	lck_spin_unlock(&vmpt_lock);
+
+	if (vmpt_drain_thread_call != NULL &&
+	    startup_phase >= STARTUP_SUB_THREAD_CALL) {
+		thread_call_enter(vmpt_drain_thread_call);
+	}
+
+	return true;
 }
 
+/*
+ * Queue the single VMPT_DISABLED event, unless it was already reported.
+ */
 /* osfmk/vm/vm_page_telemetry.c:423 */
-void
+static inline void
 vmpt_emit_disabled(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: vmpt_emit_disabled");
+	if (os_atomic_load(&vmpt_disable_reported, relaxed)) {
