 }
 
+/*
+ * Record an event: backtrace the caller, hash the identity, drop it if
+ * it is a duplicate of a recent event, queue it, and mark it in the
+ * dedupe table.  When the dedupe table is full, recording stops and the
+ * disable event is queued in place of the dropped event.
+ */
 /* osfmk/vm/vm_page_telemetry.c:438 */
 void
 vm_page_telemetry_emit(vm_page_telemetry_event_t code, uint64_t subcode)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: vm_page_telemetry_emit");
+	vmpt_ring_entry_t entry = {};
+	struct backtrace_control ctl = {};
+	backtrace_info_t info = 0;
+
+	if (os_atomic_load(&vmpt_disable, relaxed)) {
+		vmpt_emit_disabled();
+		return;
+	}
+
+	ctl.btc_frame_addr = (uintptr_t)__builtin_frame_address(0);
+	entry.frame_count = backtrace(entry.frames, VMPT_MAX_FRAMES, &ctl, &info);
+
+	entry.code = code;
+	entry.subcode = subcode;
+
+	/*
+	 * Remember which generation of the loaded kext summaries the
+	 * captured frame addresses belong to.
+	 */
+	entry.kext_timestamp = gLoadedKextSummariesTimestamp;
+
+	uint32_t hash = vmpt_hash(code, subcode, entry.frames, entry.frame_count);
+
+	if (vmpt_is_duplicate(hash)) {
+		return;
+	}
+
+	if (!vmpt_enqueue(&entry)) {
+		return;
+	}
+
+	if (!vmpt_mark_duplicate(hash)) {
+		/*
+		 * The dedupe table has no room left for this hash.  Stop
+		 * recording further events and report the shutdown once.
+		 */
+		os_atomic_store(&vmpt_disable, true, relaxed);
+		vmpt_emit_disabled();
+	}
 }
 
