 /* osfmk/vm/vm_page_telemetry.c:168 */
-uint32_t
-vmpt_hash(vm_page_telemetry_event_t code, uint64_t subcode, uintptr_t * frames, unsigned int frame_count)
+static inline uint32_t
+vmpt_hash(vm_page_telemetry_event_t code, uint64_t subcode,
+    uintptr_t * frames, unsigned int frame_count)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
