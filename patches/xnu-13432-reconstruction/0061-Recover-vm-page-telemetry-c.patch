-	vmpt_drain_thread_call = thread_call_allocate(vmpt_drain_thread, NULL);
+	vmpt_drain_thread_call = thread_call_allocate_with_options(
+		vmpt_drain_thread, NULL, THREAD_CALL_PRIORITY_KERNEL,
