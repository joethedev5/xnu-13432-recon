@@ -567,16 +565,32 @@ tcp_ecn_synack_respond(struct tcpcb * tp, uint16_t thflags)
 uint16_t
 tcp_ecn_lastack_respond(struct tcpcb * tp, uint16_t thflags)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: tcp_ecn_lastack_respond");
+	thflags &= ~TH_ACE;
+
+	if (tp->ecn_flags & TE_ACE_SETUP_CE) {
+		thflags |= (TH_CWR | TH_AE);
+	} else if (tp->ecn_flags & TE_ACE_SETUP_ECT0) {
+		thflags |= TH_AE;
+	} else if (tp->ecn_flags & TE_ACE_SETUP_ECT1) {
+		thflags |= (TH_CWR | TH_ECE);
+	} else if (tp->ecn_flags & TE_ACE_SETUP_NON_ECT) {
+		thflags |= TH_CWR;
+	}
+
+	tp->ecn_flags &= ~(TE_ACE_SETUP_NON_ECT | TE_ACE_SETUP_ECT1 |
+	    TE_ACE_SETUP_ECT0 | TE_ACE_SETUP_CE | TE_ACE_FINAL_ACK_3WHS |
+	    TE_SETUPSENT);
+
+	return thflags;
 }
 
