-/* osfmk/kern/virtual_env.c:151 */
-int
-virtual_env_path_copyin(char * dst, uint32_t * dst_size, const void * src)
+/*
+ * Copy a NUL terminated path from user space and hand back a kernel copy.
+ *
+ * osfmk/kern/virtual_env.c:151
+ */
+static int
+virtual_env_path_copyin(char **dst, uint32_t *dst_size, const void *src)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: virtual_env_path_copyin");
+	char buffer[PATH_MAX] = {};
+	size_t size;
+	int error;
+
+	if (src != NULL) {
+		error = copyinstr((user_addr_t)src, buffer, sizeof(buffer),
+		    &size);
+		if (error != 0) {
+			return error;
+		}
+
+		if (size != 0) {
+			/*
+			 * copyinstr() includes the terminating NUL in its
+			 * returned length; drop it from the count and make
+			 * sure the copy is terminated at that point.
+			 */
+			buffer[size - 1] = '\0';
+
+			*dst = kalloc_data(size, Z_WAITOK_ZERO_NOFAIL);
+			memcpy(*dst, buffer, size);
+			*dst_size = (uint32_t)size;
+		}
+	}
+	return 0;
 }
 
-/* osfmk/kern/virtual_env.c:182 */
-_Bool
+/*
+ * Virtual environments are only usable when the running system variant is
+ * a development variant.  The answer is cached in @c state.
+ *
+ * osfmk/kern/virtual_env.c:182
+ */
+bool
 virtual_env_is_available(void)
 {
-	/* RECON(13432): body not recovered from the reference kernel yet. */
-	panic("reconstructed stub: virtual_env_is_available");
+	const uint8_t QUERIED_BIT = 0x1;
+	const uint8_t AVAILABLE_BIT = 0x2;
+	static uint8_t state;
+	bool result;
+	uint8_t current_state = os_atomic_load(&state, relaxed);
+
+	if (!(current_state & QUERIED_BIT)) {
+		bool is_development =
+		    (osvariant_status & 0xc00000) == 0xc00000;
+		uint8_t new_state = QUERIED_BIT;
+
+		if (is_development) {
+			new_state |= AVAILABLE_BIT;
+		}
+
+		(void)os_atomic_cmpxchg(&state, 0, new_state, relaxed);
+
+		result = is_development;
+	} else {
+		result = (current_state & AVAILABLE_BIT) != 0;
+	}
+
+	return result;
 }
 
